<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>民诉法-戴鹏</title>
  </head>
  <body>
    <outline text="专题01 民事诉讼与民事诉讼法" _mubu_text="%3Cspan%3E%E4%B8%93%E9%A2%9801%20%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E4%B8%8E%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B3%95%3C/span%3E" _note="" _mubu_note="">
      <outline text="一、多元纠纷解决机制" _mubu_text="%3Cspan%3E%E4%B8%80%E3%80%81%E5%A4%9A%E5%85%83%E7%BA%A0%E7%BA%B7%E8%A7%A3%E5%86%B3%E6%9C%BA%E5%88%B6%3C/span%3E" _note="" _mubu_note="">
        <outline text="民事纠纷的定义" _mubu_text="%3Cspan%3E%E6%B0%91%E4%BA%8B%E7%BA%A0%E7%BA%B7%E7%9A%84%E5%AE%9A%E4%B9%89%3C/span%3E" _note="" _mubu_note="">
          <outline text="平等主体之间因人身、财产权利义务发生的纠纷" _mubu_text="%3Cspan%3E%E5%B9%B3%E7%AD%89%E4%B8%BB%E4%BD%93%E4%B9%8B%E9%97%B4%E5%9B%A0%3C/span%3E%3Cspan%20class=%22underline%22%3E%E4%BA%BA%E8%BA%AB%E3%80%81%E8%B4%A2%E4%BA%A7%3C/span%3E%3Cspan%3E%E6%9D%83%E5%88%A9%E4%B9%89%E5%8A%A1%E5%8F%91%E7%94%9F%E7%9A%84%E7%BA%A0%E7%BA%B7%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="核心特征：主体地位平等，纠纷内容为民事权利义务争议" _mubu_text="%3Cspan%3E%E6%A0%B8%E5%BF%83%E7%89%B9%E5%BE%81%EF%BC%9A%E4%B8%BB%E4%BD%93%E5%9C%B0%E4%BD%8D%E5%B9%B3%E7%AD%89%EF%BC%8C%E7%BA%A0%E7%BA%B7%E5%86%85%E5%AE%B9%E4%B8%BA%E6%B0%91%E4%BA%8B%E6%9D%83%E5%88%A9%E4%B9%89%E5%8A%A1%E4%BA%89%E8%AE%AE%3C/span%3E" _note="" _mubu_note=""/>
        </outline>
        <outline text="四种民事纠纷解决方式" _mubu_text="%3Cspan%3E%E5%9B%9B%E7%A7%8D%E6%B0%91%E4%BA%8B%E7%BA%A0%E7%BA%B7%E8%A7%A3%E5%86%B3%E6%96%B9%E5%BC%8F%3C/span%3E" _note="" _mubu_note="">
          <outline text="1. 和解（俗称“私了”）" _mubu_text="%3Cspan%3E1.%20%E5%92%8C%E8%A7%A3%EF%BC%88%E4%BF%97%E7%A7%B0%E2%80%9C%E7%A7%81%E4%BA%86%E2%80%9D%EF%BC%89%3C/span%3E" _note="" _mubu_note="">
            <outline text="参与主体：仅纠纷双方当事人" _mubu_text="%3Cspan%3E%E5%8F%82%E4%B8%8E%E4%B8%BB%E4%BD%93%EF%BC%9A%E4%BB%85%E7%BA%A0%E7%BA%B7%E5%8F%8C%E6%96%B9%E5%BD%93%E4%BA%8B%E4%BA%BA%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="特点：无任何第三方力量介入，完全基于双方自愿达成协议" _mubu_text="%3Cspan%3E%E7%89%B9%E7%82%B9%EF%BC%9A%E6%97%A0%E4%BB%BB%E4%BD%95%E7%AC%AC%E4%B8%89%E6%96%B9%E5%8A%9B%E9%87%8F%E4%BB%8B%E5%85%A5%EF%BC%8C%E5%AE%8C%E5%85%A8%E5%9F%BA%E4%BA%8E%E5%8F%8C%E6%96%B9%E8%87%AA%E6%84%BF%E8%BE%BE%E6%88%90%E5%8D%8F%E8%AE%AE%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="效力：达成的和解协议具有合同效力，无强制执行力" _mubu_text="%3Cspan%3E%E6%95%88%E5%8A%9B%EF%BC%9A%E8%BE%BE%E6%88%90%E7%9A%84%E5%92%8C%E8%A7%A3%E5%8D%8F%E8%AE%AE%E5%85%B7%E6%9C%89%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%90%88%E5%90%8C%E6%95%88%E5%8A%9B%3C/span%3E%3Cspan%3E%EF%BC%8C%3C/span%3E%3Cspan%20class=%22underline%22%3E%E6%97%A0%E5%BC%BA%E5%88%B6%E6%89%A7%E8%A1%8C%E5%8A%9B%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="2. 人民调解" _mubu_text="%3Cspan%3E2.%20%E4%BA%BA%E6%B0%91%E8%B0%83%E8%A7%A3%3C/span%3E" _note="" _mubu_note="">
            <outline text="参与主体：纠纷双方当事人+人民调解委员会（第三方社会组织）" _mubu_text="%3Cspan%3E%E5%8F%82%E4%B8%8E%E4%B8%BB%E4%BD%93%EF%BC%9A%E7%BA%A0%E7%BA%B7%E5%8F%8C%E6%96%B9%E5%BD%93%E4%BA%8B%E4%BA%BA%3C/span%3E%3Cspan%20class=%22bold%22%3E+%E4%BA%BA%E6%B0%91%E8%B0%83%E8%A7%A3%E5%A7%94%E5%91%98%E4%BC%9A%3C/span%3E%3Cspan%3E%EF%BC%88%E7%AC%AC%E4%B8%89%E6%96%B9%E7%A4%BE%E4%BC%9A%E7%BB%84%E7%BB%87%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="特点：借助社会力量，由调解员居中斡旋促进协议达成" _mubu_text="%3Cspan%3E%E7%89%B9%E7%82%B9%EF%BC%9A%E5%80%9F%E5%8A%A9%E7%A4%BE%E4%BC%9A%E5%8A%9B%E9%87%8F%EF%BC%8C%E7%94%B1%E8%B0%83%E8%A7%A3%E5%91%98%E5%B1%85%E4%B8%AD%E6%96%A1%E6%97%8B%E4%BF%83%E8%BF%9B%E5%8D%8F%E8%AE%AE%E8%BE%BE%E6%88%90%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="效力" _mubu_text="%3Cspan%3E%E6%95%88%E5%8A%9B%3C/span%3E" _note="" _mubu_note="">
              <outline text="原则：达成的调解协议具有合同效力" _mubu_text="%3Cspan%3E%E5%8E%9F%E5%88%99%EF%BC%9A%E8%BE%BE%E6%88%90%E7%9A%84%E8%B0%83%E8%A7%A3%E5%8D%8F%E8%AE%AE%E5%85%B7%E6%9C%89%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%90%88%E5%90%8C%E6%95%88%E5%8A%9B%3C/span%3E" _note="" _mubu_note=""/>
              <outline text="例外：经法院司法确认后具有强制执行力" _mubu_text="%3Cspan%3E%E4%BE%8B%E5%A4%96%EF%BC%9A%E7%BB%8F%3C/span%3E%3Cspan%20class=%22underline%22%3E%E6%B3%95%E9%99%A2%E5%8F%B8%E6%B3%95%E7%A1%AE%E8%AE%A4%E5%90%8E%3C/span%3E%3Cspan%3E%E5%85%B7%E6%9C%89%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%BC%BA%E5%88%B6%E6%89%A7%E8%A1%8C%E5%8A%9B%3C/span%3E" _note="" _mubu_note=""/>
            </outline>
          </outline>
          <outline text="3. 仲裁" _mubu_text="%3Cspan%3E3.%20%E4%BB%B2%E8%A3%81%3C/span%3E" _note="" _mubu_note="">
            <outline text="参与主体：纠纷双方当事人 + 仲裁委员会（第三方社会组织）" _mubu_text="%3Cspan%3E%E5%8F%82%E4%B8%8E%E4%B8%BB%E4%BD%93%EF%BC%9A%E7%BA%A0%E7%BA%B7%E5%8F%8C%E6%96%B9%E5%BD%93%E4%BA%8B%E4%BA%BA%20%3C/span%3E%3Cspan%20class=%22bold%22%3E+%20%E4%BB%B2%E8%A3%81%E5%A7%94%E5%91%98%E4%BC%9A%3C/span%3E%3Cspan%3E%EF%BC%88%E7%AC%AC%E4%B8%89%E6%96%B9%E7%A4%BE%E4%BC%9A%E7%BB%84%E7%BB%87%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="前提：双方必须事先 / 事后达成有效的仲裁协议" _mubu_text="%3Cspan%3E%E5%89%8D%E6%8F%90%EF%BC%9A%E5%8F%8C%E6%96%B9%E5%BF%85%E9%A1%BB%3C/span%3E%3Cspan%20class=%22underline%22%3E%E4%BA%8B%E5%85%88%20/%20%E4%BA%8B%E5%90%8E%3C/span%3E%3Cspan%3E%E8%BE%BE%E6%88%90%E6%9C%89%E6%95%88%E7%9A%84%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%BB%B2%E8%A3%81%E5%8D%8F%E8%AE%AE%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="特点：一裁终局，程序灵活，不公开审理" _mubu_text="%3Cspan%3E%E7%89%B9%E7%82%B9%EF%BC%9A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%B8%80%E8%A3%81%E7%BB%88%E5%B1%80%3C/span%3E%3Cspan%3E%EF%BC%8C%E7%A8%8B%E5%BA%8F%E7%81%B5%E6%B4%BB%EF%BC%8C%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%B8%8D%E5%85%AC%E5%BC%80%E5%AE%A1%E7%90%86%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="效力：仲裁裁决具有强制执行力" _mubu_text="%3Cspan%3E%E6%95%88%E5%8A%9B%EF%BC%9A%E4%BB%B2%E8%A3%81%E8%A3%81%E5%86%B3%E5%85%B7%E6%9C%89%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%BC%BA%E5%88%B6%E6%89%A7%E8%A1%8C%E5%8A%9B%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="4. 民事诉讼" _mubu_text="%3Cspan%3E4.%20%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%3C/span%3E" _note="" _mubu_note="">
            <outline text="参与主体：纠纷双方当事人 + 人民法院（国家审判机关）" _mubu_text="%3Cspan%3E%E5%8F%82%E4%B8%8E%E4%B8%BB%E4%BD%93%EF%BC%9A%E7%BA%A0%E7%BA%B7%E5%8F%8C%E6%96%B9%E5%BD%93%E4%BA%8B%E4%BA%BA%20%3C/span%3E%3Cspan%20class=%22bold%22%3E+%20%E4%BA%BA%E6%B0%91%E6%B3%95%E9%99%A2%3C/span%3E%3Cspan%3E%EF%BC%88%E5%9B%BD%E5%AE%B6%E5%AE%A1%E5%88%A4%E6%9C%BA%E5%85%B3%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="特点：法院行使国家审判权，程序严格规范，公开审理为原则" _mubu_text="%3Cspan%3E%E7%89%B9%E7%82%B9%EF%BC%9A%E6%B3%95%E9%99%A2%E8%A1%8C%E4%BD%BF%E5%9B%BD%E5%AE%B6%E5%AE%A1%E5%88%A4%E6%9D%83%EF%BC%8C%E7%A8%8B%E5%BA%8F%E4%B8%A5%E6%A0%BC%E8%A7%84%E8%8C%83%EF%BC%8C%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%85%AC%E5%BC%80%E5%AE%A1%E7%90%86%E4%B8%BA%E5%8E%9F%E5%88%99%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="效力：生效判决、裁定具有强制执行力" _mubu_text="%3Cspan%3E%E6%95%88%E5%8A%9B%EF%BC%9A%E7%94%9F%E6%95%88%E5%88%A4%E5%86%B3%E3%80%81%E8%A3%81%E5%AE%9A%E5%85%B7%E6%9C%89%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%BC%BA%E5%88%B6%E6%89%A7%E8%A1%8C%E5%8A%9B%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
        </outline>
        <outline text="纠纷解决机制的分类" _mubu_text="%3Cspan%3E%E7%BA%A0%E7%BA%B7%E8%A7%A3%E5%86%B3%E6%9C%BA%E5%88%B6%E7%9A%84%E5%88%86%E7%B1%BB%3C/span%3E" _note="按救济类型" _mubu_note="%3Cspan%3E%E6%8C%89%E6%95%91%E6%B5%8E%E7%B1%BB%E5%9E%8B%3C/span%3E">
          <outline text="1. 私力救济：仅依靠当事人自身力量解决纠纷" _mubu_text="%3Cspan%3E1.%20%E7%A7%81%E5%8A%9B%E6%95%91%E6%B5%8E%EF%BC%9A%E4%BB%85%E4%BE%9D%E9%9D%A0%E5%BD%93%E4%BA%8B%E4%BA%BA%E8%87%AA%E8%BA%AB%E5%8A%9B%E9%87%8F%E8%A7%A3%E5%86%B3%E7%BA%A0%E7%BA%B7%3C/span%3E" _note="典型：和解" _mubu_note="%3Cspan%3E%E5%85%B8%E5%9E%8B%EF%BC%9A%E5%92%8C%E8%A7%A3%3C/span%3E"/>
          <outline text="2. 社会救济：依靠社会第三方力量解决纠纷" _mubu_text="%3Cspan%3E2.%20%E7%A4%BE%E4%BC%9A%E6%95%91%E6%B5%8E%EF%BC%9A%E4%BE%9D%E9%9D%A0%3C/span%3E%3Cspan%20class=%22bold%22%3E%E7%A4%BE%E4%BC%9A%E7%AC%AC%E4%B8%89%E6%96%B9%3C/span%3E%3Cspan%3E%E5%8A%9B%E9%87%8F%E8%A7%A3%E5%86%B3%E7%BA%A0%E7%BA%B7%3C/span%3E" _note="典型：人民调解、仲裁" _mubu_note="%3Cspan%3E%E5%85%B8%E5%9E%8B%EF%BC%9A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%BA%BA%E6%B0%91%E8%B0%83%E8%A7%A3%E3%80%81%E4%BB%B2%E8%A3%81%3C/span%3E"/>
          <outline text="3. 公力救济：依靠国家公权力解决纠纷" _mubu_text="%3Cspan%3E3.%20%E5%85%AC%E5%8A%9B%E6%95%91%E6%B5%8E%EF%BC%9A%E4%BE%9D%E9%9D%A0%E5%9B%BD%E5%AE%B6%E5%85%AC%E6%9D%83%E5%8A%9B%E8%A7%A3%E5%86%B3%E7%BA%A0%E7%BA%B7%3C/span%3E" _note="典型：民事诉讼" _mubu_note="%3Cspan%3E%E5%85%B8%E5%9E%8B%EF%BC%9A%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%3C/span%3E"/>
        </outline>
        <outline text="【案例】甲乙公司签订合同后发生履行纠纷，解决方式" _mubu_text="%3Cspan%3E%E3%80%90%E6%A1%88%E4%BE%8B%E3%80%91%E7%94%B2%E4%B9%99%E5%85%AC%E5%8F%B8%E7%AD%BE%E8%AE%A2%E5%90%88%E5%90%8C%E5%90%8E%E5%8F%91%E7%94%9F%E5%B1%A5%E8%A1%8C%E7%BA%A0%E7%BA%B7%EF%BC%8C%E8%A7%A3%E5%86%B3%E6%96%B9%E5%BC%8F%3C/span%3E" _note="" _mubu_note="">
          <outline text="1. 双方自行协商达成和解协议" _mubu_text="%3Cspan%3E1.%20%E5%8F%8C%E6%96%B9%E8%87%AA%E8%A1%8C%E5%8D%8F%E5%95%86%E8%BE%BE%E6%88%90%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%92%8C%E8%A7%A3%E5%8D%8F%E8%AE%AE%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="2. 邀请当地人民调解委员会进行调解" _mubu_text="%3Cspan%3E2.%20%E9%82%80%E8%AF%B7%E5%BD%93%E5%9C%B0%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%BA%BA%E6%B0%91%E8%B0%83%E8%A7%A3%E5%A7%94%E5%91%98%E4%BC%9A%3C/span%3E%3Cspan%3E%E8%BF%9B%E8%A1%8C%E8%B0%83%E8%A7%A3%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="3. 若双方有仲裁协议，提交约定的仲裁委员会仲裁" _mubu_text="%3Cspan%3E3.%20%E8%8B%A5%E5%8F%8C%E6%96%B9%E6%9C%89%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%BB%B2%E8%A3%81%E5%8D%8F%E8%AE%AE%3C/span%3E%3Cspan%3E%EF%BC%8C%E6%8F%90%E4%BA%A4%E7%BA%A6%E5%AE%9A%E7%9A%84%E4%BB%B2%E8%A3%81%E5%A7%94%E5%91%98%E4%BC%9A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%BB%B2%E8%A3%81%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="4. 向有管辖权的人民法院提起民事诉讼" _mubu_text="%3Cspan%3E4.%20%E5%90%91%E6%9C%89%E7%AE%A1%E8%BE%96%E6%9D%83%E7%9A%84%E4%BA%BA%E6%B0%91%E6%B3%95%E9%99%A2%E6%8F%90%E8%B5%B7%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%3C/span%3E" _note="" _mubu_note=""/>
        </outline>
      </outline>
      <outline text="二、民事审判程序的分类 #必考" _mubu_text="%3Cspan%3E%E4%BA%8C%E3%80%81%E6%B0%91%E4%BA%8B%E5%AE%A1%E5%88%A4%E7%A8%8B%E5%BA%8F%E7%9A%84%E5%88%86%E7%B1%BB%20%3C/span%3E%3Cspan%20class=%22tag%22%3E#%E5%BF%85%E8%80%83%3C/span%3E" _note="高频考点，贯穿整个民诉法学习" _mubu_note="%3Cspan%3E%E9%AB%98%E9%A2%91%E8%80%83%E7%82%B9%EF%BC%8C%E8%B4%AF%E7%A9%BF%E6%95%B4%E4%B8%AA%E6%B0%91%E8%AF%89%E6%B3%95%E5%AD%A6%E4%B9%A0%3C/span%3E">
        <outline text="分类标准：民事审判程序中是否解决民事权利义务纠纷" _mubu_text="%3Cspan%3E%E5%88%86%E7%B1%BB%E6%A0%87%E5%87%86%EF%BC%9A%E6%B0%91%E4%BA%8B%E5%AE%A1%E5%88%A4%E7%A8%8B%E5%BA%8F%E4%B8%AD%3C/span%3E%3Cspan%20class=%22bold%22%3E%E6%98%AF%E5%90%A6%E8%A7%A3%E5%86%B3%3C/span%3E%3Cspan%3E%E6%B0%91%E4%BA%8B%E6%9D%83%E5%88%A9%E4%B9%89%E5%8A%A1%3C/span%3E%3Cspan%20class=%22bold%22%3E%E7%BA%A0%E7%BA%B7%3C/span%3E" _note="" _mubu_note=""/>
        <outline text="1. 诉讼程序" _mubu_text="%3Cspan%3E1.%20%E8%AF%89%E8%AE%BC%E7%A8%8B%E5%BA%8F%3C/span%3E" _note="解决纠纷" _mubu_note="%3Cspan%3E%E8%A7%A3%E5%86%B3%E7%BA%A0%E7%BA%B7%3C/span%3E">
          <outline text="民事诉讼的概念" _mubu_text="%3Cspan%3E%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E7%9A%84%E6%A6%82%E5%BF%B5%3C/span%3E" _note="" _mubu_note="">
            <outline text="定义：平等主体之间发生民事纠纷后，向人民法院提起诉讼，由法院居中裁判解决纠纷的活动" _mubu_text="%3Cspan%20class=%22strikethrough%22%3E%E5%AE%9A%E4%B9%89%EF%BC%9A%E5%B9%B3%E7%AD%89%E4%B8%BB%E4%BD%93%E4%B9%8B%E9%97%B4%E5%8F%91%E7%94%9F%E6%B0%91%E4%BA%8B%E7%BA%A0%E7%BA%B7%E5%90%8E%EF%BC%8C%E5%90%91%E4%BA%BA%E6%B0%91%E6%B3%95%E9%99%A2%E6%8F%90%E8%B5%B7%E8%AF%89%E8%AE%BC%EF%BC%8C%E7%94%B1%E6%B3%95%E9%99%A2%E5%B1%85%E4%B8%AD%E8%A3%81%E5%88%A4%E8%A7%A3%E5%86%B3%E7%BA%A0%E7%BA%B7%E7%9A%84%E6%B4%BB%E5%8A%A8%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="本质：原告与被告平等对抗，法院居中裁判，目的是解决平等主体之间的人身、财产权利义务纠纷" _mubu_text="%3Cspan%20class=%22strikethrough%22%3E%E6%9C%AC%E8%B4%A8%EF%BC%9A%3C/span%3E%3Cspan%20class=%22bold%20strikethrough%22%3E%E5%8E%9F%E5%91%8A%E4%B8%8E%E8%A2%AB%E5%91%8A%E5%B9%B3%E7%AD%89%E5%AF%B9%E6%8A%97%EF%BC%8C%E6%B3%95%E9%99%A2%E5%B1%85%E4%B8%AD%E8%A3%81%E5%88%A4%3C/span%3E%3Cspan%20class=%22strikethrough%22%3E%EF%BC%8C%E7%9B%AE%E7%9A%84%E6%98%AF%E8%A7%A3%E5%86%B3%E5%B9%B3%E7%AD%89%E4%B8%BB%E4%BD%93%E4%B9%8B%E9%97%B4%E7%9A%84%E4%BA%BA%E8%BA%AB%E3%80%81%E8%B4%A2%E4%BA%A7%E6%9D%83%E5%88%A9%E4%B9%89%E5%8A%A1%E7%BA%A0%E7%BA%B7%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="核心特征：存在平等主体的对抗，法院对实体民事权利义务争议作出裁判" _mubu_text="%3Cspan%3E%E6%A0%B8%E5%BF%83%E7%89%B9%E5%BE%81%EF%BC%9A%E5%AD%98%E5%9C%A8%E5%B9%B3%E7%AD%89%E4%B8%BB%E4%BD%93%E7%9A%84%E5%AF%B9%E6%8A%97%EF%BC%8C%E6%B3%95%E9%99%A2%E5%AF%B9%3C/span%3E%3Cspan%20class=%22bold%20underline%22%3E%E5%AE%9E%E4%BD%93%3C/span%3E%3Cspan%20class=%22underline%22%3E%E6%B0%91%E4%BA%8B%E6%9D%83%E5%88%A9%E4%B9%89%E5%8A%A1%3C/span%3E%3Cspan%3E%E4%BA%89%E8%AE%AE%E4%BD%9C%E5%87%BA%E8%A3%81%E5%88%A4%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="范围：一审程序、二审程序、再审程序" _mubu_text="%3Cspan%3E%E8%8C%83%E5%9B%B4%EF%BC%9A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%B8%80%E5%AE%A1%3C/span%3E%3Cspan%3E%E7%A8%8B%E5%BA%8F%E3%80%81%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%BA%8C%E5%AE%A1%3C/span%3E%3Cspan%3E%E7%A8%8B%E5%BA%8F%E3%80%81%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%86%8D%E5%AE%A1%3C/span%3E%3Cspan%3E%E7%A8%8B%E5%BA%8F%3C/span%3E" _note="" _mubu_note=""/>
        </outline>
        <outline text="2. 非讼程序" _mubu_text="%3Cspan%3E2.%20%E9%9D%9E%E8%AE%BC%E7%A8%8B%E5%BA%8F%3C/span%3E" _note="不解决纠纷" _mubu_note="%3Cspan%3E%E4%B8%8D%E8%A7%A3%E5%86%B3%E7%BA%A0%E7%BA%B7%3C/span%3E">
          <outline text="核心特征：无平等主体的对抗，法院仅对某种法律事实 / 权利状态进行确认" _mubu_text="%3Cspan%3E%E6%A0%B8%E5%BF%83%E7%89%B9%E5%BE%81%EF%BC%9A%E6%97%A0%E5%B9%B3%E7%AD%89%E4%B8%BB%E4%BD%93%E7%9A%84%E5%AF%B9%E6%8A%97%EF%BC%8C%E6%B3%95%E9%99%A2%E4%BB%85%E5%AF%B9%3C/span%3E%3Cspan%20class=%22underline%22%3E%E6%9F%90%E7%A7%8D%E6%B3%95%E5%BE%8B%E4%BA%8B%E5%AE%9E%3C/span%3E%3Cspan%3E%20/%20%3C/span%3E%3Cspan%20class=%22underline%22%3E%E6%9D%83%E5%88%A9%E7%8A%B6%E6%80%81%3C/span%3E%3Cspan%3E%E8%BF%9B%E8%A1%8C%3C/span%3E%3Cspan%20class=%22bold%22%3E%E7%A1%AE%E8%AE%A4%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="范围" _mubu_text="%3Cspan%3E%E8%8C%83%E5%9B%B4%3C/span%3E" _note="" _mubu_note="">
            <outline text="特别程序（选民资格案件除外）" _mubu_text="%3Cspan%3E%E7%89%B9%E5%88%AB%E7%A8%8B%E5%BA%8F%EF%BC%88%3C/span%3E%3Cspan%20class=%22bold%22%3E%E9%80%89%E6%B0%91%E8%B5%84%E6%A0%BC%E6%A1%88%E4%BB%B6%E9%99%A4%E5%A4%96%3C/span%3E%3Cspan%3E%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="督促程序（支付令程序）" _mubu_text="%3Cspan%3E%E7%9D%A3%E4%BF%83%E7%A8%8B%E5%BA%8F%EF%BC%88%E6%94%AF%E4%BB%98%E4%BB%A4%E7%A8%8B%E5%BA%8F%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="公示催告程序" _mubu_text="%3Cspan%3E%E5%85%AC%E7%A4%BA%E5%82%AC%E5%91%8A%E7%A8%8B%E5%BA%8F%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
        </outline>
        <outline text="3. 特殊：选民资格案件" _mubu_text="%3Cspan%3E3.%20%E7%89%B9%E6%AE%8A%EF%BC%9A%E9%80%89%E6%B0%91%E8%B5%84%E6%A0%BC%E6%A1%88%E4%BB%B6%3C/span%3E" _note="" _mubu_note="">
          <outline text="解决的是公民的选举权与被选举权（政治权利）争议，而非民事权利义务纠纷" _mubu_text="%3Cspan%3E%E8%A7%A3%E5%86%B3%E7%9A%84%E6%98%AF%E5%85%AC%E6%B0%91%E7%9A%84%E9%80%89%E4%B8%BE%E6%9D%83%E4%B8%8E%E8%A2%AB%E9%80%89%E4%B8%BE%E6%9D%83%EF%BC%88%E6%94%BF%E6%B2%BB%E6%9D%83%E5%88%A9%EF%BC%89%E4%BA%89%E8%AE%AE%EF%BC%8C%E8%80%8C%E9%9D%9E%E6%B0%91%E4%BA%8B%E6%9D%83%E5%88%A9%E4%B9%89%E5%8A%A1%E7%BA%A0%E7%BA%B7%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="性质：不属于民事审判程序，因此既不是诉讼程序，也不是非讼程序" _mubu_text="%3Cspan%3E%E6%80%A7%E8%B4%A8%EF%BC%9A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%B8%8D%E5%B1%9E%E4%BA%8E%E6%B0%91%E4%BA%8B%E5%AE%A1%E5%88%A4%E7%A8%8B%E5%BA%8F%3C/span%3E%3Cspan%3E%EF%BC%8C%E5%9B%A0%E6%AD%A4%3C/span%3E%3Cspan%20class=%22underline%22%3E%E6%97%A2%E4%B8%8D%E6%98%AF%E8%AF%89%E8%AE%BC%E7%A8%8B%E5%BA%8F%EF%BC%8C%E4%B9%9F%E4%B8%8D%E6%98%AF%E9%9D%9E%E8%AE%BC%E7%A8%8B%E5%BA%8F%3C/span%3E" _note="" _mubu_note=""/>
        </outline>
        <outline text="辅助理解要点" _mubu_text="%3Cspan%3E%E8%BE%85%E5%8A%A9%E7%90%86%E8%A7%A3%E8%A6%81%E7%82%B9%3C/span%3E" _note="" _mubu_note="">
          <outline text="诉讼程序与非讼程序的区分不仅是直接考点，更是理解后续很多制度的基础（如证明责任、审理方式、审级制度等）" _mubu_text="%3Cspan%3E%E8%AF%89%E8%AE%BC%E7%A8%8B%E5%BA%8F%E4%B8%8E%E9%9D%9E%E8%AE%BC%E7%A8%8B%E5%BA%8F%E7%9A%84%E5%8C%BA%E5%88%86%E4%B8%8D%E4%BB%85%E6%98%AF%E7%9B%B4%E6%8E%A5%E8%80%83%E7%82%B9%EF%BC%8C%E6%9B%B4%E6%98%AF%E7%90%86%E8%A7%A3%E5%90%8E%E7%BB%AD%E5%BE%88%E5%A4%9A%E5%88%B6%E5%BA%A6%E7%9A%84%E5%9F%BA%E7%A1%80%EF%BC%88%E5%A6%82%E8%AF%81%E6%98%8E%E8%B4%A3%E4%BB%BB%E3%80%81%E5%AE%A1%E7%90%86%E6%96%B9%E5%BC%8F%E3%80%81%E5%AE%A1%E7%BA%A7%E5%88%B6%E5%BA%A6%E7%AD%89%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="非讼程序中没有“原告”“被告”的概念，只有“申请人”“被申请人”" _mubu_text="%3Cspan%20class=%22bold%22%3E%E9%9D%9E%E8%AE%BC%E7%A8%8B%E5%BA%8F%3C/span%3E%3Cspan%3E%E4%B8%AD%E6%B2%A1%E6%9C%89%E2%80%9C%E5%8E%9F%E5%91%8A%E2%80%9D%E2%80%9C%E8%A2%AB%E5%91%8A%E2%80%9D%E7%9A%84%E6%A6%82%E5%BF%B5%EF%BC%8C%E5%8F%AA%E6%9C%89%E2%80%9C%E7%94%B3%E8%AF%B7%E4%BA%BA%E2%80%9D%E2%80%9C%E8%A2%AB%E7%94%B3%E8%AF%B7%E4%BA%BA%E2%80%9D%3C/span%3E" _note="" _mubu_note=""/>
        </outline>
        <outline text="注意：执行程序的性质" _mubu_text="%3Cspan%3E%E6%B3%A8%E6%84%8F%EF%BC%9A%E6%89%A7%E8%A1%8C%E7%A8%8B%E5%BA%8F%E7%9A%84%E6%80%A7%E8%B4%A8%3C/span%3E" _note="" _mubu_note="">
          <outline text="执行程序是民事诉讼法规定的程序，但不属于民事审判程序" _mubu_text="%3Cspan%3E%E6%89%A7%E8%A1%8C%E7%A8%8B%E5%BA%8F%E6%98%AF%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B3%95%E8%A7%84%E5%AE%9A%E7%9A%84%E7%A8%8B%E5%BA%8F%EF%BC%8C%E4%BD%86%3C/span%3E%3Cspan%20class=%22bold%20underline%22%3E%E4%B8%8D%E5%B1%9E%E4%BA%8E%3C/span%3E%3Cspan%20class=%22underline%22%3E%E6%B0%91%E4%BA%8B%3C/span%3E%3Cspan%20class=%22bold%20underline%22%3E%E5%AE%A1%E5%88%A4%3C/span%3E%3Cspan%20class=%22underline%22%3E%E7%A8%8B%E5%BA%8F%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="执行程序的目的是实现生效法律文书确定的权利义务，而非解决纠纷" _mubu_text="%3Cspan%3E%E6%89%A7%E8%A1%8C%E7%A8%8B%E5%BA%8F%E7%9A%84%E7%9B%AE%E7%9A%84%E6%98%AF%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%AE%9E%E7%8E%B0%3C/span%3E%3Cspan%3E%E7%94%9F%E6%95%88%E6%B3%95%E5%BE%8B%E6%96%87%E4%B9%A6%E7%A1%AE%E5%AE%9A%E7%9A%84%E6%9D%83%E5%88%A9%E4%B9%89%E5%8A%A1%EF%BC%8C%E8%80%8C%E9%9D%9E%E8%A7%A3%E5%86%B3%E7%BA%A0%E7%BA%B7%3C/span%3E" _note="因此既不是诉讼程序，也不是非讼程序" _mubu_note="%3Cspan%3E%E5%9B%A0%E6%AD%A4%E6%97%A2%E4%B8%8D%E6%98%AF%E8%AF%89%E8%AE%BC%E7%A8%8B%E5%BA%8F%EF%BC%8C%E4%B9%9F%E4%B8%8D%E6%98%AF%E9%9D%9E%E8%AE%BC%E7%A8%8B%E5%BA%8F%3C/span%3E"/>
        </outline>
      </outline>
      <outline text="三、民事诉讼法的属性与效力" _mubu_text="%3Cspan%3E%E4%B8%89%E3%80%81%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B3%95%E7%9A%84%E5%B1%9E%E6%80%A7%E4%B8%8E%E6%95%88%E5%8A%9B%3C/span%3E" _note="" _mubu_note="">
        <outline text="民事诉讼法的四大属性 #必考" _mubu_text="%3Cspan%3E%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B3%95%E7%9A%84%E5%9B%9B%E5%A4%A7%E5%B1%9E%E6%80%A7%20%3C/span%3E%3Cspan%20class=%22tag%22%3E#%E5%BF%85%E8%80%83%3C/span%3E" _note="" _mubu_note="">
          <outline text="1. 基本法" _mubu_text="%3Cspan%3E1.%20%E5%9F%BA%E6%9C%AC%E6%B3%95%3C/span%3E" _note="" _mubu_note="">
            <outline text="角度：从国家法律体系中的地位而言" _mubu_text="%3Cspan%3E%E8%A7%92%E5%BA%A6%EF%BC%9A%E4%BB%8E%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%9B%BD%E5%AE%B6%E6%B3%95%E5%BE%8B%E4%BD%93%E7%B3%BB%E4%B8%AD%E7%9A%84%E5%9C%B0%E4%BD%8D%3C/span%3E%3Cspan%3E%E8%80%8C%E8%A8%80%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="含义：民事诉讼法是国家基本法律之一，效力仅次于宪法" _mubu_text="%3Cspan%3E%E5%90%AB%E4%B9%89%EF%BC%9A%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B3%95%E6%98%AF%E5%9B%BD%E5%AE%B6%E5%9F%BA%E6%9C%AC%E6%B3%95%E5%BE%8B%E4%B9%8B%E4%B8%80%EF%BC%8C%E6%95%88%E5%8A%9B%E4%BB%85%E6%AC%A1%E4%BA%8E%E5%AE%AA%E6%B3%95%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="2. 部门法" _mubu_text="%3Cspan%3E2.%20%E9%83%A8%E9%97%A8%E6%B3%95%3C/span%3E" _note="" _mubu_note="">
            <outline text="角度：从调整的社会关系而言" _mubu_text="%3Cspan%3E%E8%A7%92%E5%BA%A6%EF%BC%9A%E4%BB%8E%3C/span%3E%3Cspan%20class=%22bold%22%3E%E8%B0%83%E6%95%B4%E7%9A%84%E7%A4%BE%E4%BC%9A%E5%85%B3%E7%B3%BB%3C/span%3E%3Cspan%3E%E8%80%8C%E8%A8%80%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="含义：仅调整民事诉讼活动中产生的民事诉讼法律关系" _mubu_text="%3Cspan%3E%E5%90%AB%E4%B9%89%EF%BC%9A%E4%BB%85%E8%B0%83%E6%95%B4%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B4%BB%E5%8A%A8%E4%B8%AD%E4%BA%A7%E7%94%9F%E7%9A%84%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="3. 程序法" _mubu_text="%3Cspan%3E3.%20%E7%A8%8B%E5%BA%8F%E6%B3%95%3C/span%3E" _note="" _mubu_note="">
            <outline text="角度：从法律规定的内容而言" _mubu_text="%3Cspan%3E%E8%A7%92%E5%BA%A6%EF%BC%9A%E4%BB%8E%3C/span%3E%3Cspan%20class=%22bold%22%3E%E6%B3%95%E5%BE%8B%E8%A7%84%E5%AE%9A%E7%9A%84%E5%86%85%E5%AE%B9%3C/span%3E%3Cspan%3E%E8%80%8C%E8%A8%80%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="含义：主要规定民事诉讼的程序、制度和规则，与规定实体权利义务的实体法（如民法）相对应" _mubu_text="%3Cspan%3E%E5%90%AB%E4%B9%89%EF%BC%9A%E4%B8%BB%E8%A6%81%E8%A7%84%E5%AE%9A%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E7%9A%84%E7%A8%8B%E5%BA%8F%E3%80%81%E5%88%B6%E5%BA%A6%E5%92%8C%E8%A7%84%E5%88%99%EF%BC%8C%E4%B8%8E%E8%A7%84%E5%AE%9A%E5%AE%9E%E4%BD%93%E6%9D%83%E5%88%A9%E4%B9%89%E5%8A%A1%E7%9A%84%E5%AE%9E%E4%BD%93%E6%B3%95%EF%BC%88%E5%A6%82%E6%B0%91%E6%B3%95%EF%BC%89%E7%9B%B8%E5%AF%B9%E5%BA%94%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="4. 公法" _mubu_text="%3Cspan%3E4.%20%E5%85%AC%E6%B3%95%3C/span%3E" _note="" _mubu_note="">
            <outline text="角度：从法律的适用主体而言" _mubu_text="%3Cspan%3E%E8%A7%92%E5%BA%A6%EF%BC%9A%E4%BB%8E%3C/span%3E%3Cspan%20class=%22bold%22%3E%E6%B3%95%E5%BE%8B%E7%9A%84%E9%80%82%E7%94%A8%E4%B8%BB%E4%BD%93%3C/span%3E%3Cspan%3E%E8%80%8C%E8%A8%80%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="含义：主要规范法院行使国家审判权的行为，涉及国家公权力的行使，与规范平等主体之间关系的私法相对应" _mubu_text="%3Cspan%3E%E5%90%AB%E4%B9%89%EF%BC%9A%E4%B8%BB%E8%A6%81%3C/span%3E%3Cspan%20class=%22underline%22%3E%E8%A7%84%E8%8C%83%3C/span%3E%3Cspan%20class=%22bold%20underline%22%3E%E6%B3%95%E9%99%A2%3C/span%3E%3Cspan%3E%E8%A1%8C%E4%BD%BF%3C/span%3E%3Cspan%20class=%22underline%22%3E%E5%9B%BD%E5%AE%B6%E5%AE%A1%E5%88%A4%E6%9D%83%3C/span%3E%3Cspan%3E%E7%9A%84%E8%A1%8C%E4%B8%BA%EF%BC%8C%E6%B6%89%E5%8F%8A%E5%9B%BD%E5%AE%B6%E5%85%AC%E6%9D%83%E5%8A%9B%E7%9A%84%E8%A1%8C%E4%BD%BF%EF%BC%8C%E4%B8%8E%E8%A7%84%E8%8C%83%E5%B9%B3%E7%AD%89%E4%B8%BB%E4%BD%93%E4%B9%8B%E9%97%B4%E5%85%B3%E7%B3%BB%E7%9A%84%E7%A7%81%E6%B3%95%E7%9B%B8%E5%AF%B9%E5%BA%94%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
        </outline>
        <outline text="民事诉讼法的效力" _mubu_text="%3Cspan%3E%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B3%95%E7%9A%84%E6%95%88%E5%8A%9B%3C/span%3E" _note="核心考点，易与国际私法结合考查" _mubu_note="%3Cspan%3E%E6%A0%B8%E5%BF%83%E8%80%83%E7%82%B9%EF%BC%8C%E6%98%93%E4%B8%8E%E5%9B%BD%E9%99%85%E7%A7%81%E6%B3%95%E7%BB%93%E5%90%88%E8%80%83%E6%9F%A5%3C/span%3E">
          <outline text="核心规则：只要在中国领域内进行民事诉讼，必须适用中国的民事诉讼法" _mubu_text="%3Cspan%3E%E6%A0%B8%E5%BF%83%E8%A7%84%E5%88%99%EF%BC%9A%E5%8F%AA%E8%A6%81%3C/span%3E%3Cspan%20class=%22underline%22%3E%E5%9C%A8%E4%B8%AD%E5%9B%BD%E9%A2%86%E5%9F%9F%E5%86%85%3C/span%3E%3Cspan%3E%E8%BF%9B%E8%A1%8C%3C/span%3E%3Cspan%20class=%22bold%22%3E%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%3C/span%3E%3Cspan%3E%EF%BC%8C%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%BF%85%E9%A1%BB%E9%80%82%E7%94%A8%3C/span%3E%3Cspan%3E%E4%B8%AD%E5%9B%BD%E7%9A%84%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B3%95%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="绝对效力：不存在在中国适用外国民事诉讼法的可能，当事人也不得约定适用外国民事诉讼法" _mubu_text="%3Cspan%3E%E7%BB%9D%E5%AF%B9%E6%95%88%E5%8A%9B%EF%BC%9A%E4%B8%8D%E5%AD%98%E5%9C%A8%3C/span%3E%3Cspan%20class=%22underline%22%3E%E5%9C%A8%E4%B8%AD%E5%9B%BD%3C/span%3E%3Cspan%3E%E9%80%82%E7%94%A8%E5%A4%96%E5%9B%BD%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B3%95%E7%9A%84%E5%8F%AF%E8%83%BD%EF%BC%8C%E5%BD%93%E4%BA%8B%E4%BA%BA%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%B9%9F%E4%B8%8D%E5%BE%97%E7%BA%A6%E5%AE%9A%3C/span%3E%3Cspan%3E%E9%80%82%E7%94%A8%E5%A4%96%E5%9B%BD%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B3%95%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="程序法与实体法适用的区别" _mubu_text="%3Cspan%3E%E7%A8%8B%E5%BA%8F%E6%B3%95%E4%B8%8E%E5%AE%9E%E4%BD%93%E6%B3%95%E9%80%82%E7%94%A8%E7%9A%84%E5%8C%BA%E5%88%AB%3C/span%3E" _note="" _mubu_note="">
            <outline text="程序法（民事诉讼法）：只能适用法院地法（中国法），当事人约定无效" _mubu_text="%3Cspan%3E%E7%A8%8B%E5%BA%8F%E6%B3%95%EF%BC%88%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B3%95%EF%BC%89%EF%BC%9A%E5%8F%AA%E8%83%BD%E9%80%82%E7%94%A8%E6%B3%95%E9%99%A2%E5%9C%B0%E6%B3%95%EF%BC%88%E4%B8%AD%E5%9B%BD%E6%B3%95%EF%BC%89%EF%BC%8C%E5%BD%93%E4%BA%8B%E4%BA%BA%E7%BA%A6%E5%AE%9A%E6%97%A0%E6%95%88%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="实体法（民法、合同法等）：可以根据当事人的约定适用外国法" _mubu_text="%3Cspan%20class=%22bold%22%3E%E5%AE%9E%E4%BD%93%E6%B3%95%3C/span%3E%3Cspan%3E%EF%BC%88%E6%B0%91%E6%B3%95%E3%80%81%E5%90%88%E5%90%8C%E6%B3%95%E7%AD%89%EF%BC%89%EF%BC%9A%E5%8F%AF%E4%BB%A5%E6%A0%B9%E6%8D%AE%E5%BD%93%E4%BA%8B%E4%BA%BA%E7%9A%84%3C/span%3E%3Cspan%20class=%22bold%22%3E%E7%BA%A6%E5%AE%9A%E9%80%82%E7%94%A8%E5%A4%96%E5%9B%BD%E6%B3%95%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
        </outline>
        <outline text="【案例】中日公司合同纠纷的法律适用" _mubu_text="%3Cspan%3E%E3%80%90%E6%A1%88%E4%BE%8B%E3%80%91%E4%B8%AD%E6%97%A5%E5%85%AC%E5%8F%B8%E5%90%88%E5%90%8C%E7%BA%A0%E7%BA%B7%E7%9A%84%E6%B3%95%E5%BE%8B%E9%80%82%E7%94%A8%3C/span%3E" _note="" _mubu_note="">
          <outline text="案情：中国甲公司与日本乙公司签订买卖合同，合同约定“因履行本合同产生的纠纷一律适用日本法律解决”。后双方发生纠纷，甲公司向中国法院起诉，中国法院受理了案件。" _mubu_text="%3Cspan%3E%E6%A1%88%E6%83%85%EF%BC%9A%E4%B8%AD%E5%9B%BD%E7%94%B2%E5%85%AC%E5%8F%B8%E4%B8%8E%E6%97%A5%E6%9C%AC%E4%B9%99%E5%85%AC%E5%8F%B8%E7%AD%BE%E8%AE%A2%E4%B9%B0%E5%8D%96%E5%90%88%E5%90%8C%EF%BC%8C%E5%90%88%E5%90%8C%E7%BA%A6%E5%AE%9A%E2%80%9C%E5%9B%A0%E5%B1%A5%E8%A1%8C%E6%9C%AC%E5%90%88%E5%90%8C%E4%BA%A7%E7%94%9F%E7%9A%84%E7%BA%A0%E7%BA%B7%E4%B8%80%E5%BE%8B%E9%80%82%E7%94%A8%E6%97%A5%E6%9C%AC%E6%B3%95%E5%BE%8B%E8%A7%A3%E5%86%B3%E2%80%9D%E3%80%82%E5%90%8E%E5%8F%8C%E6%96%B9%E5%8F%91%E7%94%9F%E7%BA%A0%E7%BA%B7%EF%BC%8C%E7%94%B2%E5%85%AC%E5%8F%B8%E5%90%91%E4%B8%AD%E5%9B%BD%E6%B3%95%E9%99%A2%E8%B5%B7%E8%AF%89%EF%BC%8C%E4%B8%AD%E5%9B%BD%E6%B3%95%E9%99%A2%E5%8F%97%E7%90%86%E4%BA%86%E6%A1%88%E4%BB%B6%E3%80%82%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="法律适用" _mubu_text="%3Cspan%3E%E6%B3%95%E5%BE%8B%E9%80%82%E7%94%A8%3C/span%3E" _note="" _mubu_note="">
            <outline text="程序问题：必须适用中国的民事诉讼法，当事人约定适用日本程序法的部分无效" _mubu_text="%3Cspan%3E%E7%A8%8B%E5%BA%8F%E9%97%AE%E9%A2%98%EF%BC%9A%E5%BF%85%E9%A1%BB%E9%80%82%E7%94%A8%E4%B8%AD%E5%9B%BD%E7%9A%84%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E6%B3%95%EF%BC%8C%E5%BD%93%E4%BA%8B%E4%BA%BA%E7%BA%A6%E5%AE%9A%E9%80%82%E7%94%A8%E6%97%A5%E6%9C%AC%E7%A8%8B%E5%BA%8F%E6%B3%95%E7%9A%84%E9%83%A8%E5%88%86%E6%97%A0%E6%95%88%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="实体问题：当事人约定适用日本民法、合同法的部分有效，法院可以根据约定适用日本实体法" _mubu_text="%3Cspan%3E%E5%AE%9E%E4%BD%93%E9%97%AE%E9%A2%98%EF%BC%9A%E5%BD%93%E4%BA%8B%E4%BA%BA%E7%BA%A6%E5%AE%9A%E9%80%82%E7%94%A8%E6%97%A5%E6%9C%AC%E6%B0%91%E6%B3%95%E3%80%81%E5%90%88%E5%90%8C%E6%B3%95%E7%9A%84%E9%83%A8%E5%88%86%E6%9C%89%E6%95%88%EF%BC%8C%E6%B3%95%E9%99%A2%E5%8F%AF%E4%BB%A5%E6%A0%B9%E6%8D%AE%E7%BA%A6%E5%AE%9A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E9%80%82%E7%94%A8%E6%97%A5%E6%9C%AC%E5%AE%9E%E4%BD%93%E6%B3%95%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
        </outline>
      </outline>
    </outline>
    <outline text="专题02 诉的基本理论" _mubu_text="%3Cspan%3E%E4%B8%93%E9%A2%9802%20%E8%AF%89%E7%9A%84%E5%9F%BA%E6%9C%AC%E7%90%86%E8%AE%BA%3C/span%3E" _note="本专题仅讨论诉讼程序中的“诉”" _mubu_note="%3Cspan%3E%E6%9C%AC%E4%B8%93%E9%A2%98%E4%BB%85%E8%AE%A8%E8%AE%BA%E8%AF%89%E8%AE%BC%E7%A8%8B%E5%BA%8F%E4%B8%AD%E7%9A%84%E2%80%9C%E8%AF%89%E2%80%9D%3C/span%3E">
      <outline text="一、诉的要素" _mubu_text="%3Cspan%3E%E4%B8%80%E3%80%81%E8%AF%89%E7%9A%84%E8%A6%81%E7%B4%A0%3C/span%3E" _note="" _mubu_note="">
        <outline text="一个诉由三个要素构成：当事人（主体）、诉讼标的（客体）、诉的理由" _mubu_text="%3Cspan%3E%E4%B8%80%E4%B8%AA%E8%AF%89%E7%94%B1%E4%B8%89%E4%B8%AA%E8%A6%81%E7%B4%A0%E6%9E%84%E6%88%90%EF%BC%9A%3C/span%3E%3Cspan%20class=%22underline%22%3E%E5%BD%93%E4%BA%8B%E4%BA%BA%EF%BC%88%E4%B8%BB%E4%BD%93%EF%BC%89%3C/span%3E%3Cspan%3E%E3%80%81%3C/span%3E%3Cspan%20class=%22underline%22%3E%E8%AF%89%E8%AE%BC%E6%A0%87%E7%9A%84%EF%BC%88%E5%AE%A2%E4%BD%93%EF%BC%89%3C/span%3E%3Cspan%3E%E3%80%81%3C/span%3E%3Cspan%20class=%22underline%22%3E%E8%AF%89%E7%9A%84%E7%90%86%E7%94%B1%3C/span%3E" _note="" _mubu_note=""/>
        <outline text="核心考点：诉讼标的的判断与区分" _mubu_text="%3Cspan%3E%E6%A0%B8%E5%BF%83%E8%80%83%E7%82%B9%EF%BC%9A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E8%AF%89%E8%AE%BC%E6%A0%87%E7%9A%84%3C/span%3E%3Cspan%3E%E7%9A%84%E5%88%A4%E6%96%AD%E4%B8%8E%E5%8C%BA%E5%88%86%3C/span%3E" _note="" _mubu_note="">
          <outline text="诉讼标的的定义" _mubu_text="%3Cspan%3E%E8%AF%89%E8%AE%BC%E6%A0%87%E7%9A%84%E7%9A%84%E5%AE%9A%E4%B9%89%3C/span%3E" _note="" _mubu_note="">
            <outline text="本质：双方当事人发生争议，并请求法院作出裁判的实体法律关系" _mubu_text="%3Cspan%3E%E6%9C%AC%E8%B4%A8%EF%BC%9A%E5%8F%8C%E6%96%B9%E5%BD%93%E4%BA%8B%E4%BA%BA%E5%8F%91%E7%94%9F%E4%BA%89%E8%AE%AE%EF%BC%8C%E5%B9%B6%E8%AF%B7%E6%B1%82%E6%B3%95%E9%99%A2%E4%BD%9C%E5%87%BA%E8%A3%81%E5%88%A4%E7%9A%84%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%AE%9E%E4%BD%93%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="#秒杀技巧 考试中问诉讼标的，直接选带“关系”二字的选项，不带“关系”的绝对错误" _mubu_text="%3Cspan%20class=%22tag%22%3E#%E7%A7%92%E6%9D%80%E6%8A%80%E5%B7%A7%3C/span%3E%3Cspan%3E%20%E8%80%83%E8%AF%95%E4%B8%AD%E9%97%AE%E8%AF%89%E8%AE%BC%E6%A0%87%E7%9A%84%EF%BC%8C%E7%9B%B4%E6%8E%A5%E9%80%89%3C/span%3E%3Cspan%20class=%22underline%22%3E%E5%B8%A6%3C/span%3E%3Cspan%20class=%22bold%20underline%22%3E%E2%80%9C%E5%85%B3%E7%B3%BB%E2%80%9D%3C/span%3E%3Cspan%20class=%22underline%22%3E%E4%BA%8C%E5%AD%97%E7%9A%84%E9%80%89%E9%A1%B9%3C/span%3E%3Cspan%3E%EF%BC%8C%E4%B8%8D%E5%B8%A6%E2%80%9C%E5%85%B3%E7%B3%BB%E2%80%9D%E7%9A%84%E7%BB%9D%E5%AF%B9%E9%94%99%E8%AF%AF%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="诉讼标的 vs 诉讼请求" _mubu_text="%3Cspan%3E%E8%AF%89%E8%AE%BC%E6%A0%87%E7%9A%84%20vs%20%E8%AF%89%E8%AE%BC%E8%AF%B7%E6%B1%82%3C/span%3E" _note="" _mubu_note="">
            <outline text="| 概念 | 本质 | 举例 |
| --- | --- | --- |
| 诉讼标的 | 争议的实体法律关系（一个诉只有一个） | 相邻权法律关系、借款合同法律关系 |
| 诉讼请求 | 基于诉讼标的提出的具体要求（一个诉可以有多个） | 清除建筑材料、归还本金、支付利息、支付违约金 |" _mubu_text="%3Cdiv%20class=%22table-container%22%3E%3Ctable%20class=%22auto-table%22%20border=%221%22%20cellspacing=%220%22%20style=%22border-collapse:%20collapse;%22%3E%3Cthead%3E%3Ctr%3E%3Cth%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22column-select-btn%22%20data-col=%220%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E5%88%97%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cdiv%20class=%22row-select-btn%22%20data-row=%220%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E8%A1%8C%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E6%A6%82%E5%BF%B5%3C/span%3E%3C/th%3E%3Cth%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22column-select-btn%22%20data-col=%221%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E5%88%97%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E6%9C%AC%E8%B4%A8%3C/span%3E%3C/th%3E%3Cth%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22column-select-btn%22%20data-col=%222%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E5%88%97%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E4%B8%BE%E4%BE%8B%3C/span%3E%3C/th%3E%3C/tr%3E%3C/thead%3E%3Ctbody%3E%3Ctr%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22row-select-btn%22%20data-row=%221%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E8%A1%8C%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E8%AF%89%E8%AE%BC%E6%A0%87%E7%9A%84%3C/span%3E%3C/td%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E4%BA%89%E8%AE%AE%E7%9A%84%E5%AE%9E%E4%BD%93%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%EF%BC%88%E4%B8%80%E4%B8%AA%E8%AF%89%3Cb%3E%E5%8F%AA%E6%9C%89%E4%B8%80%E4%B8%AA%3C/b%3E%EF%BC%89%3C/span%3E%3C/td%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E7%9B%B8%E9%82%BB%E6%9D%83%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%E3%80%81%E5%80%9F%E6%AC%BE%E5%90%88%E5%90%8C%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3C/span%3E%3C/td%3E%3C/tr%3E%3Ctr%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22row-select-btn%22%20data-row=%222%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E8%A1%8C%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E8%AF%89%E8%AE%BC%E8%AF%B7%E6%B1%82%3C/span%3E%3C/td%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E5%9F%BA%E4%BA%8E%E8%AF%89%E8%AE%BC%E6%A0%87%E7%9A%84%E6%8F%90%E5%87%BA%E7%9A%84%3Cb%3E%E5%85%B7%E4%BD%93%E8%A6%81%E6%B1%82%3C/b%3E%EF%BC%88%E4%B8%80%E4%B8%AA%E8%AF%89%E5%8F%AF%E4%BB%A5%E6%9C%89%3Cb%3E%E5%A4%9A%E4%B8%AA%3C/b%3E%EF%BC%89%3C/span%3E%3C/td%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E6%B8%85%E9%99%A4%E5%BB%BA%E7%AD%91%E6%9D%90%E6%96%99%E3%80%81%E5%BD%92%E8%BF%98%E6%9C%AC%E9%87%91%E3%80%81%E6%94%AF%E4%BB%98%E5%88%A9%E6%81%AF%E3%80%81%E6%94%AF%E4%BB%98%E8%BF%9D%E7%BA%A6%E9%87%91%3C/span%3E%3C/td%3E%3C/tr%3E%3C/tbody%3E%3C/table%3E%3C/div%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="区分案例" _mubu_text="%3Cspan%3E%E5%8C%BA%E5%88%86%E6%A1%88%E4%BE%8B%3C/span%3E" _note="" _mubu_note="">
            <outline text="案例1：张三起诉李四要求清除门口建筑材料保障通行" _mubu_text="%3Cspan%3E%E6%A1%88%E4%BE%8B1%EF%BC%9A%E5%BC%A0%E4%B8%89%E8%B5%B7%E8%AF%89%E6%9D%8E%E5%9B%9B%E8%A6%81%E6%B1%82%E6%B8%85%E9%99%A4%E9%97%A8%E5%8F%A3%E5%BB%BA%E7%AD%91%E6%9D%90%E6%96%99%E4%BF%9D%E9%9A%9C%E9%80%9A%E8%A1%8C%3C/span%3E" _note="" _mubu_note="">
              <outline text="诉讼标的：张三与李四之间的相邻权法律关系" _mubu_text="%3Cspan%3E%E8%AF%89%E8%AE%BC%E6%A0%87%E7%9A%84%EF%BC%9A%E5%BC%A0%E4%B8%89%E4%B8%8E%E6%9D%8E%E5%9B%9B%E4%B9%8B%E9%97%B4%E7%9A%84%E7%9B%B8%E9%82%BB%E6%9D%83%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3C/span%3E" _note="" _mubu_note=""/>
              <outline text="诉讼请求：清除建筑材料、保障通行便利" _mubu_text="%3Cspan%3E%E8%AF%89%E8%AE%BC%E8%AF%B7%E6%B1%82%EF%BC%9A%E6%B8%85%E9%99%A4%E5%BB%BA%E7%AD%91%E6%9D%90%E6%96%99%E3%80%81%E4%BF%9D%E9%9A%9C%E9%80%9A%E8%A1%8C%E4%BE%BF%E5%88%A9%3C/span%3E" _note="" _mubu_note=""/>
            </outline>
            <outline text="案例2：张三起诉李四要求归还借款本金10万、利息2万、违约金3万" _mubu_text="%3Cspan%3E%E6%A1%88%E4%BE%8B2%EF%BC%9A%E5%BC%A0%E4%B8%89%E8%B5%B7%E8%AF%89%E6%9D%8E%E5%9B%9B%E8%A6%81%E6%B1%82%E5%BD%92%E8%BF%98%E5%80%9F%E6%AC%BE%E6%9C%AC%E9%87%9110%E4%B8%87%E3%80%81%E5%88%A9%E6%81%AF2%E4%B8%87%E3%80%81%E8%BF%9D%E7%BA%A6%E9%87%913%E4%B8%87%3C/span%3E" _note="" _mubu_note="">
              <outline text="诉讼标的：张三与李四之间的借款合同法律关系（1个）" _mubu_text="%3Cspan%3E%E8%AF%89%E8%AE%BC%E6%A0%87%E7%9A%84%EF%BC%9A%E5%BC%A0%E4%B8%89%E4%B8%8E%E6%9D%8E%E5%9B%9B%E4%B9%8B%E9%97%B4%E7%9A%84%E5%80%9F%E6%AC%BE%E5%90%88%E5%90%8C%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%EF%BC%881%E4%B8%AA%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
              <outline text="诉讼请求：归还本金、支付利息、支付违约金（3个）" _mubu_text="%3Cspan%3E%E8%AF%89%E8%AE%BC%E8%AF%B7%E6%B1%82%EF%BC%9A%E5%BD%92%E8%BF%98%E6%9C%AC%E9%87%91%E3%80%81%E6%94%AF%E4%BB%98%E5%88%A9%E6%81%AF%E3%80%81%E6%94%AF%E4%BB%98%E8%BF%9D%E7%BA%A6%E9%87%91%EF%BC%883%E4%B8%AA%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            </outline>
            <outline text="案例3：张三起诉李四要求支付租金1万，诉讼中变更为要求解除租赁合同" _mubu_text="%3Cspan%3E%E6%A1%88%E4%BE%8B3%EF%BC%9A%E5%BC%A0%E4%B8%89%E8%B5%B7%E8%AF%89%E6%9D%8E%E5%9B%9B%E8%A6%81%E6%B1%82%E6%94%AF%E4%BB%98%E7%A7%9F%E9%87%911%E4%B8%87%EF%BC%8C%E8%AF%89%E8%AE%BC%E4%B8%AD%E5%8F%98%E6%9B%B4%E4%B8%BA%E8%A6%81%E6%B1%82%E8%A7%A3%E9%99%A4%E7%A7%9F%E8%B5%81%E5%90%88%E5%90%8C%3C/span%3E" _note="" _mubu_note="">
              <outline text="诉讼标的：张三与李四之间的租赁合同法律关系（未变）" _mubu_text="%3Cspan%3E%E8%AF%89%E8%AE%BC%E6%A0%87%E7%9A%84%EF%BC%9A%E5%BC%A0%E4%B8%89%E4%B8%8E%E6%9D%8E%E5%9B%9B%E4%B9%8B%E9%97%B4%E7%9A%84%E7%A7%9F%E8%B5%81%E5%90%88%E5%90%8C%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%EF%BC%88%E6%9C%AA%E5%8F%98%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
              <outline text="诉讼请求：从“支付租金”变更为“解除合同”（已变）" _mubu_text="%3Cspan%3E%E8%AF%89%E8%AE%BC%E8%AF%B7%E6%B1%82%EF%BC%9A%E4%BB%8E%E2%80%9C%E6%94%AF%E4%BB%98%E7%A7%9F%E9%87%91%E2%80%9D%E5%8F%98%E6%9B%B4%E4%B8%BA%E2%80%9C%E8%A7%A3%E9%99%A4%E5%90%88%E5%90%8C%E2%80%9D%EF%BC%88%E5%B7%B2%E5%8F%98%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            </outline>
          </outline>
        </outline>
      </outline>
      <outline text="二、诉的分类" _mubu_text="%3Cspan%3E%E4%BA%8C%E3%80%81%E8%AF%89%E7%9A%84%E5%88%86%E7%B1%BB%3C/span%3E" _note="核心考点，贯穿民诉全程" _mubu_note="%3Cspan%3E%E6%A0%B8%E5%BF%83%E8%80%83%E7%82%B9%EF%BC%8C%E8%B4%AF%E7%A9%BF%E6%B0%91%E8%AF%89%E5%85%A8%E7%A8%8B%3C/span%3E">
        <outline text="分类标准：原告的诉讼请求（唯一标准，绝对不看被告的答辩意见）" _mubu_text="%3Cspan%3E%E5%88%86%E7%B1%BB%E6%A0%87%E5%87%86%EF%BC%9A%3C/span%3E%3Cspan%20class=%22bold%20underline%22%3E%E5%8E%9F%E5%91%8A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E7%9A%84%E8%AF%89%E8%AE%BC%E8%AF%B7%E6%B1%82%3C/span%3E%3Cspan%3E%EF%BC%88%E5%94%AF%E4%B8%80%E6%A0%87%E5%87%86%EF%BC%8C%3C/span%3E%3Cspan%20class=%22strikethrough%22%3E%E7%BB%9D%E5%AF%B9%E4%B8%8D%E7%9C%8B%E8%A2%AB%E5%91%8A%E7%9A%84%E7%AD%94%E8%BE%A9%E6%84%8F%E8%A7%81%3C/span%3E%3Cspan%3E%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
        <outline text="三大类型：确认之诉、给付之诉、形成之诉（变更之诉）" _mubu_text="%3Cspan%3E%E4%B8%89%E5%A4%A7%E7%B1%BB%E5%9E%8B%EF%BC%9A%3C/span%3E%3Cspan%20class=%22underline%22%3E%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%3C/span%3E%3Cspan%3E%E3%80%81%3C/span%3E%3Cspan%20class=%22underline%22%3E%E7%BB%99%E4%BB%98%E4%B9%8B%E8%AF%89%3C/span%3E%3Cspan%3E%E3%80%81%3C/span%3E%3Cspan%20class=%22underline%22%3E%E5%BD%A2%E6%88%90%E4%B9%8B%E8%AF%89%EF%BC%88%E5%8F%98%E6%9B%B4%E4%B9%8B%E8%AF%89%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
        <outline text="（一）确认之诉" _mubu_text="%3Cspan%3E%EF%BC%88%E4%B8%80%EF%BC%89%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%3C/span%3E" _note="" _mubu_note="">
          <outline text="1. 定义：原告请求法院确认与被告之间某种法律关系是否存在、是否有效的诉" _mubu_text="%3Cspan%3E1.%20%E5%AE%9A%E4%B9%89%EF%BC%9A%E5%8E%9F%E5%91%8A%E8%AF%B7%E6%B1%82%E6%B3%95%E9%99%A2%E7%A1%AE%E8%AE%A4%E4%B8%8E%E8%A2%AB%E5%91%8A%E4%B9%8B%E9%97%B4%3C/span%3E%3Cspan%20class=%22underline%22%3E%E6%9F%90%E7%A7%8D%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3C/span%3E%3Cspan%20class=%22bold%22%3E%E6%98%AF%E5%90%A6%E5%AD%98%E5%9C%A8%E3%80%81%E6%98%AF%E5%90%A6%E6%9C%89%E6%95%88%3C/span%3E%3Cspan%3E%E7%9A%84%E8%AF%89%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="2. 分类" _mubu_text="%3Cspan%3E2.%20%E5%88%86%E7%B1%BB%3C/span%3E" _note="" _mubu_note="">
            <outline text="积极确认之诉：请求确认法律关系存在/有效（如确认合同有效、确认婚姻关系有效）" _mubu_text="%3Cspan%3E%E7%A7%AF%E6%9E%81%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%EF%BC%9A%E8%AF%B7%E6%B1%82%E7%A1%AE%E8%AE%A4%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3C/span%3E%3Cspan%20class=%22underline%22%3E%E5%AD%98%E5%9C%A8/%E6%9C%89%E6%95%88%3C/span%3E%3Cspan%3E%EF%BC%88%E5%A6%82%E7%A1%AE%E8%AE%A4%E5%90%88%E5%90%8C%E6%9C%89%E6%95%88%E3%80%81%E7%A1%AE%E8%AE%A4%E5%A9%9A%E5%A7%BB%E5%85%B3%E7%B3%BB%E6%9C%89%E6%95%88%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="消极确认之诉：请求确认法律关系不存在/无效（如确认合同无效、确认婚姻关系无效）" _mubu_text="%3Cspan%3E%E6%B6%88%E6%9E%81%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%EF%BC%9A%E8%AF%B7%E6%B1%82%E7%A1%AE%E8%AE%A4%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3C/span%3E%3Cspan%20class=%22underline%22%3E%E4%B8%8D%E5%AD%98%E5%9C%A8/%E6%97%A0%E6%95%88%3C/span%3E%3Cspan%3E%EF%BC%88%E5%A6%82%E7%A1%AE%E8%AE%A4%E5%90%88%E5%90%8C%E6%97%A0%E6%95%88%E3%80%81%E7%A1%AE%E8%AE%A4%E5%A9%9A%E5%A7%BB%E5%85%B3%E7%B3%BB%E6%97%A0%E6%95%88%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="3. 易错点 #必考" _mubu_text="%3Cspan%3E3.%20%E6%98%93%E9%94%99%E7%82%B9%20%3C/span%3E%3Cspan%20class=%22tag%22%3E#%E5%BF%85%E8%80%83%3C/span%3E" _note="" _mubu_note="">
            <outline text="确认之诉的对象只能是法律关系，不能是单纯的事实状态或行为" _mubu_text="%3Cspan%3E%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%E7%9A%84%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%AF%B9%E8%B1%A1%E5%8F%AA%E8%83%BD%E6%98%AF%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3C/span%3E%3Cspan%3E%EF%BC%8C%E4%B8%8D%E8%83%BD%E6%98%AF%E5%8D%95%E7%BA%AF%E7%9A%84%3C/span%3E%3Cspan%20class=%22underline%22%3E%E4%BA%8B%E5%AE%9E%E7%8A%B6%E6%80%81%3C/span%3E%3Cspan%3E%E6%88%96%3C/span%3E%3Cspan%20class=%22underline%22%3E%E8%A1%8C%E4%B8%BA%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="反例1：甲公司起诉乙公司请求确认乙公司存在违规操作设备的行为（不是确认之诉）" _mubu_text="%3Cspan%3E%E5%8F%8D%E4%BE%8B1%EF%BC%9A%E7%94%B2%E5%85%AC%E5%8F%B8%E8%B5%B7%E8%AF%89%E4%B9%99%E5%85%AC%E5%8F%B8%E8%AF%B7%E6%B1%82%E7%A1%AE%E8%AE%A4%E4%B9%99%E5%85%AC%E5%8F%B8%E5%AD%98%E5%9C%A8%E8%BF%9D%E8%A7%84%E6%93%8D%E4%BD%9C%E8%AE%BE%E5%A4%87%E7%9A%84%E8%A1%8C%E4%B8%BA%EF%BC%88%E4%B8%8D%E6%98%AF%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="反例2：债务人李四起诉债权人张三请求确认张三的债权已过诉讼时效（不是确认之诉）" _mubu_text="%3Cspan%3E%E5%8F%8D%E4%BE%8B2%EF%BC%9A%E5%80%BA%E5%8A%A1%E4%BA%BA%E6%9D%8E%E5%9B%9B%E8%B5%B7%E8%AF%89%E5%80%BA%E6%9D%83%E4%BA%BA%E5%BC%A0%E4%B8%89%E8%AF%B7%E6%B1%82%E7%A1%AE%E8%AE%A4%E5%BC%A0%E4%B8%89%E7%9A%84%E5%80%BA%E6%9D%83%E5%B7%B2%E8%BF%87%E8%AF%89%E8%AE%BC%E6%97%B6%E6%95%88%EF%BC%88%E4%B8%8D%E6%98%AF%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
        </outline>
        <outline text="（二）给付之诉" _mubu_text="%3Cspan%3E%EF%BC%88%E4%BA%8C%EF%BC%89%E7%BB%99%E4%BB%98%E4%B9%8B%E8%AF%89%3C/span%3E" _note="" _mubu_note="">
          <outline text="1. 定义：原告请求法院判令被告履行一定义务的诉" _mubu_text="%3Cspan%3E1.%20%E5%AE%9A%E4%B9%89%EF%BC%9A%E5%8E%9F%E5%91%8A%E8%AF%B7%E6%B1%82%E6%B3%95%E9%99%A2%E5%88%A4%E4%BB%A4%E8%A2%AB%E5%91%8A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%B1%A5%E8%A1%8C%E4%B8%80%E5%AE%9A%E4%B9%89%E5%8A%A1%3C/span%3E%3Cspan%3E%E7%9A%84%E8%AF%89%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="2. 给付内容：三种类型" _mubu_text="%3Cspan%3E2.%20%E7%BB%99%E4%BB%98%E5%86%85%E5%AE%B9%EF%BC%9A%E4%B8%89%E7%A7%8D%E7%B1%BB%E5%9E%8B%3C/span%3E" _note="" _mubu_note="">
            <outline text="财物的给付（如赔偿损失、返还借款）" _mubu_text="%3Cspan%20class=%22underline%22%3E%E8%B4%A2%E7%89%A9%3C/span%3E%3Cspan%3E%E7%9A%84%E7%BB%99%E4%BB%98%EF%BC%88%E5%A6%82%E8%B5%94%E5%81%BF%E6%8D%9F%E5%A4%B1%E3%80%81%E8%BF%94%E8%BF%98%E5%80%9F%E6%AC%BE%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="积极行为的给付（如赔礼道歉、修理房屋）" _mubu_text="%3Cspan%20class=%22underline%22%3E%E7%A7%AF%E6%9E%81%E8%A1%8C%E4%B8%BA%3C/span%3E%3Cspan%3E%E7%9A%84%E7%BB%99%E4%BB%98%EF%BC%88%E5%A6%82%E8%B5%94%E7%A4%BC%E9%81%93%E6%AD%89%E3%80%81%E4%BF%AE%E7%90%86%E6%88%BF%E5%B1%8B%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="消极行为的给付（如停止侵权、禁止泄露商业秘密）" _mubu_text="%3Cspan%20class=%22underline%22%3E%E6%B6%88%E6%9E%81%E8%A1%8C%E4%B8%BA%3C/span%3E%3Cspan%3E%E7%9A%84%E7%BB%99%E4%BB%98%EF%BC%88%E5%A6%82%E5%81%9C%E6%AD%A2%E4%BE%B5%E6%9D%83%E3%80%81%E7%A6%81%E6%AD%A2%E6%B3%84%E9%9C%B2%E5%95%86%E4%B8%9A%E7%A7%98%E5%AF%86%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="【案例】李佳起诉左宁名誉权侵权" _mubu_text="%3Cspan%3E%E3%80%90%E6%A1%88%E4%BE%8B%E3%80%91%E6%9D%8E%E4%BD%B3%E8%B5%B7%E8%AF%89%E5%B7%A6%E5%AE%81%E5%90%8D%E8%AA%89%E6%9D%83%E4%BE%B5%E6%9D%83%3C/span%3E" _note="" _mubu_note="">
            <outline text="诉讼请求1：赔偿精神损害抚慰金10万（财物给付）" _mubu_text="%3Cspan%3E%E8%AF%89%E8%AE%BC%E8%AF%B7%E6%B1%821%EF%BC%9A%E8%B5%94%E5%81%BF%E7%B2%BE%E7%A5%9E%E6%8D%9F%E5%AE%B3%E6%8A%9A%E6%85%B0%E9%87%9110%E4%B8%87%EF%BC%88%E8%B4%A2%E7%89%A9%E7%BB%99%E4%BB%98%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="诉讼请求2：公开赔礼道歉（积极行为给付）" _mubu_text="%3Cspan%3E%E8%AF%89%E8%AE%BC%E8%AF%B7%E6%B1%822%EF%BC%9A%E5%85%AC%E5%BC%80%E8%B5%94%E7%A4%BC%E9%81%93%E6%AD%89%EF%BC%88%E7%A7%AF%E6%9E%81%E8%A1%8C%E4%B8%BA%E7%BB%99%E4%BB%98%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="诉讼请求3：停止侵权行为（消极行为给付）" _mubu_text="%3Cspan%3E%E8%AF%89%E8%AE%BC%E8%AF%B7%E6%B1%823%EF%BC%9A%E5%81%9C%E6%AD%A2%E4%BE%B5%E6%9D%83%E8%A1%8C%E4%B8%BA%EF%BC%88%E6%B6%88%E6%9E%81%E8%A1%8C%E4%B8%BA%E7%BB%99%E4%BB%98%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
        </outline>
        <outline text="（三）形成之诉（变更之诉）" _mubu_text="%3Cspan%3E%EF%BC%88%E4%B8%89%EF%BC%89%E5%BD%A2%E6%88%90%E4%B9%8B%E8%AF%89%EF%BC%88%E5%8F%98%E6%9B%B4%E4%B9%8B%E8%AF%89%EF%BC%89%3C/span%3E" _note="" _mubu_note="">
          <outline text="1. 定义：原告请求法院变更或消灭与被告之间某种既存且有效的法律关系的诉" _mubu_text="%3Cspan%3E1.%20%E5%AE%9A%E4%B9%89%EF%BC%9A%E5%8E%9F%E5%91%8A%E8%AF%B7%E6%B1%82%E6%B3%95%E9%99%A2%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%8F%98%E6%9B%B4%E6%88%96%E6%B6%88%E7%81%AD%3C/span%3E%3Cspan%3E%E4%B8%8E%E8%A2%AB%E5%91%8A%E4%B9%8B%E9%97%B4%E6%9F%90%E7%A7%8D%3C/span%3E%3Cspan%20class=%22bold%22%3E%E6%97%A2%E5%AD%98%E4%B8%94%E6%9C%89%E6%95%88%E7%9A%84%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3C/span%3E%3Cspan%3E%E7%9A%84%E8%AF%89%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="2. 核心特征：待变更/消灭的法律关系本身是合法有效的，只是原告希望通过判决将其改变或消灭" _mubu_text="%3Cspan%3E2.%20%E6%A0%B8%E5%BF%83%E7%89%B9%E5%BE%81%EF%BC%9A%E5%BE%85%E5%8F%98%E6%9B%B4/%E6%B6%88%E7%81%AD%E7%9A%84%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%E6%9C%AC%E8%BA%AB%E6%98%AF%E5%90%88%E6%B3%95%E6%9C%89%E6%95%88%E7%9A%84%EF%BC%8C%E5%8F%AA%E6%98%AF%E5%8E%9F%E5%91%8A%E5%B8%8C%E6%9C%9B%E9%80%9A%E8%BF%87%E5%88%A4%E5%86%B3%E5%B0%86%E5%85%B6%E6%94%B9%E5%8F%98%E6%88%96%E6%B6%88%E7%81%AD%3C/span%3E" _note="" _mubu_note=""/>
          <outline text="3. 拓展：法律关系的三要素（主体、客体、内容）任一变更，均构成形成之诉" _mubu_text="%3Cspan%3E3.%20%E6%8B%93%E5%B1%95%EF%BC%9A%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%E7%9A%84%E4%B8%89%E8%A6%81%E7%B4%A0%EF%BC%88%E4%B8%BB%E4%BD%93%E3%80%81%E5%AE%A2%E4%BD%93%E3%80%81%E5%86%85%E5%AE%B9%EF%BC%89%E4%BB%BB%E4%B8%80%E5%8F%98%E6%9B%B4%EF%BC%8C%E5%9D%87%E6%9E%84%E6%88%90%E5%BD%A2%E6%88%90%E4%B9%8B%E8%AF%89%3C/span%3E" _note="" _mubu_note="">
            <outline text="变更客体（消灭整个法律关系）：离婚诉讼、解除收养关系、撤销合同" _mubu_text="%3Cspan%3E%E5%8F%98%E6%9B%B4%E5%AE%A2%E4%BD%93%EF%BC%88%E6%B6%88%E7%81%AD%E6%95%B4%E4%B8%AA%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%EF%BC%89%EF%BC%9A%E7%A6%BB%E5%A9%9A%E8%AF%89%E8%AE%BC%E3%80%81%E8%A7%A3%E9%99%A4%E6%94%B6%E5%85%BB%E5%85%B3%E7%B3%BB%E3%80%81%E6%92%A4%E9%94%80%E5%90%88%E5%90%8C%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="变更主体：张三起诉前妻李四请求将婚生子张小三判归自己抚养" _mubu_text="%3Cspan%3E%E5%8F%98%E6%9B%B4%E4%B8%BB%E4%BD%93%EF%BC%9A%E5%BC%A0%E4%B8%89%E8%B5%B7%E8%AF%89%E5%89%8D%E5%A6%BB%E6%9D%8E%E5%9B%9B%E8%AF%B7%E6%B1%82%E5%B0%86%E5%A9%9A%E7%94%9F%E5%AD%90%E5%BC%A0%E5%B0%8F%E4%B8%89%E5%88%A4%E5%BD%92%E8%87%AA%E5%B7%B1%E6%8A%9A%E5%85%BB%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="变更内容：张三代理儿子起诉前妻李四请求将抚养费从每月2000元增加到3000元" _mubu_text="%3Cspan%3E%E5%8F%98%E6%9B%B4%E5%86%85%E5%AE%B9%EF%BC%9A%E5%BC%A0%E4%B8%89%E4%BB%A3%E7%90%86%E5%84%BF%E5%AD%90%E8%B5%B7%E8%AF%89%E5%89%8D%E5%A6%BB%E6%9D%8E%E5%9B%9B%E8%AF%B7%E6%B1%82%E5%B0%86%E6%8A%9A%E5%85%BB%E8%B4%B9%E4%BB%8E%E6%AF%8F%E6%9C%882000%E5%85%83%E5%A2%9E%E5%8A%A0%E5%88%B03000%E5%85%83%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
        </outline>
        <outline text="诉的分类五大拓展结论 #必考" _mubu_text="%3Cspan%3E%E8%AF%89%E7%9A%84%E5%88%86%E7%B1%BB%E4%BA%94%E5%A4%A7%E6%8B%93%E5%B1%95%E7%BB%93%E8%AE%BA%20%3C/span%3E%3Cspan%20class=%22tag%22%3E#%E5%BF%85%E8%80%83%3C/span%3E" _note="" _mubu_note="">
          <outline text="1. 非讼程序不讨论诉的分类" _mubu_text="%3Cspan%3E1.%20%E9%9D%9E%E8%AE%BC%E7%A8%8B%E5%BA%8F%E4%B8%8D%E8%AE%A8%E8%AE%BA%E8%AF%89%E7%9A%84%E5%88%86%E7%B1%BB%3C/span%3E" _note="确认调解协议效力、确认财产无主、确认公民为无/限制民事行为能力等特别程序，根本不是“诉”，不得讨论其属于哪类诉" _mubu_note="%3Cspan%3E%E7%A1%AE%E8%AE%A4%E8%B0%83%E8%A7%A3%E5%8D%8F%E8%AE%AE%E6%95%88%E5%8A%9B%E3%80%81%E7%A1%AE%E8%AE%A4%E8%B4%A2%E4%BA%A7%E6%97%A0%E4%B8%BB%E3%80%81%E7%A1%AE%E8%AE%A4%E5%85%AC%E6%B0%91%E4%B8%BA%E6%97%A0/%E9%99%90%E5%88%B6%E6%B0%91%E4%BA%8B%E8%A1%8C%E4%B8%BA%E8%83%BD%E5%8A%9B%E7%AD%89%E7%89%B9%E5%88%AB%E7%A8%8B%E5%BA%8F%EF%BC%8C%E6%A0%B9%E6%9C%AC%E4%B8%8D%E6%98%AF%E2%80%9C%E8%AF%89%E2%80%9D%EF%BC%8C%E4%B8%8D%E5%BE%97%E8%AE%A8%E8%AE%BA%E5%85%B6%E5%B1%9E%E4%BA%8E%E5%93%AA%E7%B1%BB%E8%AF%89%3C/span%3E"/>
          <outline text="2. 诉的分类唯一依据是原告的诉讼请求" _mubu_text="%3Cspan%3E2.%20%E8%AF%89%E7%9A%84%E5%88%86%E7%B1%BB%E5%94%AF%E4%B8%80%E4%BE%9D%E6%8D%AE%E6%98%AF%E5%8E%9F%E5%91%8A%E7%9A%84%E8%AF%89%E8%AE%BC%E8%AF%B7%E6%B1%82%3C/span%3E" _note="与被告的答辩意见无关" _mubu_note="%3Cspan%3E%E4%B8%8E%E8%A2%AB%E5%91%8A%E7%9A%84%E7%AD%94%E8%BE%A9%E6%84%8F%E8%A7%81%E6%97%A0%E5%85%B3%3C/span%3E">
            <outline text="例题：张三起诉李四要求归还借款10万，李四答辩称借款关系不存在" _mubu_text="%3Cspan%3E%E4%BE%8B%E9%A2%98%EF%BC%9A%E5%BC%A0%E4%B8%89%E8%B5%B7%E8%AF%89%E6%9D%8E%E5%9B%9B%E8%A6%81%E6%B1%82%E5%BD%92%E8%BF%98%E5%80%9F%E6%AC%BE10%E4%B8%87%EF%BC%8C%E6%9D%8E%E5%9B%9B%E7%AD%94%E8%BE%A9%E7%A7%B0%E5%80%9F%E6%AC%BE%E5%85%B3%E7%B3%BB%E4%B8%8D%E5%AD%98%E5%9C%A8%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="分析：原告诉讼请求是“还钱”（给付请求），因此是给付之诉，不是确认之诉" _mubu_text="%3Cspan%3E%E5%88%86%E6%9E%90%EF%BC%9A%E5%8E%9F%E5%91%8A%E8%AF%89%E8%AE%BC%E8%AF%B7%E6%B1%82%E6%98%AF%E2%80%9C%E8%BF%98%E9%92%B1%E2%80%9D%EF%BC%88%E7%BB%99%E4%BB%98%E8%AF%B7%E6%B1%82%EF%BC%89%EF%BC%8C%E5%9B%A0%E6%AD%A4%E6%98%AF%3C/span%3E%3Cspan%20class=%22bold%22%3E%E7%BB%99%E4%BB%98%E4%B9%8B%E8%AF%89%3C/span%3E%3Cspan%3E%EF%BC%8C%E4%B8%8D%E6%98%AF%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="3. 给付之诉、形成之诉中往往包含确认的内容，但只要原告提出了给付 / 变更请求，就不再是确认之诉" _mubu_text="%3Cspan%3E3.%20%E7%BB%99%E4%BB%98%E4%B9%8B%E8%AF%89%E3%80%81%E5%BD%A2%E6%88%90%E4%B9%8B%E8%AF%89%E4%B8%AD%E5%BE%80%E5%BE%80%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%8C%85%E5%90%AB%E7%A1%AE%E8%AE%A4%3C/span%3E%3Cspan%3E%E7%9A%84%E5%86%85%E5%AE%B9%EF%BC%8C%E4%BD%86%E5%8F%AA%E8%A6%81%E5%8E%9F%E5%91%8A%3C/span%3E%3Cspan%20class=%22underline%22%3E%E6%8F%90%E5%87%BA%E4%BA%86%3C/span%3E%3Cspan%20class=%22bold%20underline%22%3E%E7%BB%99%E4%BB%98%20/%20%E5%8F%98%E6%9B%B4%3C/span%3E%3Cspan%20class=%22underline%22%3E%E8%AF%B7%E6%B1%82%3C/span%3E%3Cspan%3E%EF%BC%8C%E5%B0%B1%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%B8%8D%E5%86%8D%E6%98%AF%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%3C/span%3E" _note="确认之诉的本质：只求确认，不求给付，不求变更" _mubu_note="%3Cspan%3E%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%E7%9A%84%E6%9C%AC%E8%B4%A8%EF%BC%9A%E5%8F%AA%E6%B1%82%E7%A1%AE%E8%AE%A4%EF%BC%8C%E4%B8%8D%E6%B1%82%E7%BB%99%E4%BB%98%EF%BC%8C%E4%B8%8D%E6%B1%82%E5%8F%98%E6%9B%B4%3C/span%3E"/>
          <outline text="4. 消极确认之诉 vs 形成之诉的区别" _mubu_text="%3Cspan%3E4.%20%E6%B6%88%E6%9E%81%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%20vs%20%E5%BD%A2%E6%88%90%E4%B9%8B%E8%AF%89%E7%9A%84%E5%8C%BA%E5%88%AB%3C/span%3E" _note="" _mubu_note="">
            <outline text="| 类型 | 待处理法律关系的状态 | 判决效力 |
| --- | --- | --- |
| 消极确认之诉 | 法律关系是否存在/有效本身存在争议 | 判决确认法律关系不存在/无效 |
| 形成之诉 | 法律关系本身是既存且有效的 | 判决直接变更/消灭既存的法律关系 |" _mubu_text="%3Cdiv%20class=%22table-container%22%3E%3Ctable%20class=%22auto-table%22%20border=%221%22%20cellspacing=%220%22%20style=%22border-collapse:%20collapse;%22%3E%3Cthead%3E%3Ctr%3E%3Cth%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22column-select-btn%22%20data-col=%220%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E5%88%97%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cdiv%20class=%22row-select-btn%22%20data-row=%220%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E8%A1%8C%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E7%B1%BB%E5%9E%8B%3C/span%3E%3C/th%3E%3Cth%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22column-select-btn%22%20data-col=%221%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E5%88%97%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E5%BE%85%E5%A4%84%E7%90%86%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%E7%9A%84%E7%8A%B6%E6%80%81%3C/span%3E%3C/th%3E%3Cth%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22column-select-btn%22%20data-col=%222%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E5%88%97%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E5%88%A4%E5%86%B3%E6%95%88%E5%8A%9B%3C/span%3E%3C/th%3E%3C/tr%3E%3C/thead%3E%3Ctbody%3E%3Ctr%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22row-select-btn%22%20data-row=%221%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E8%A1%8C%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E6%B6%88%E6%9E%81%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%3C/span%3E%3C/td%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3Cb%3E%E6%98%AF%E5%90%A6%E5%AD%98%E5%9C%A8/%E6%9C%89%E6%95%88%3C/b%3E%3Cu%3E%3Cb%3E%E6%9C%AC%E8%BA%AB%3C/b%3E%3C/u%3E%E5%AD%98%E5%9C%A8%E4%BA%89%E8%AE%AE%3C/span%3E%3C/td%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E5%88%A4%E5%86%B3%E7%A1%AE%E8%AE%A4%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%E4%B8%8D%E5%AD%98%E5%9C%A8/%E6%97%A0%E6%95%88%3C/span%3E%3C/td%3E%3C/tr%3E%3Ctr%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22row-select-btn%22%20data-row=%222%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E8%A1%8C%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E5%BD%A2%E6%88%90%E4%B9%8B%E8%AF%89%3C/span%3E%3C/td%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3Cu%3E%3Cb%3E%E6%9C%AC%E8%BA%AB%3C/b%3E%3C/u%3E%3Cb%3E%E6%98%AF%E6%97%A2%E5%AD%98%E4%B8%94%E6%9C%89%E6%95%88%3C/b%3E%E7%9A%84%3C/span%3E%3C/td%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E5%88%A4%E5%86%B3%E7%9B%B4%E6%8E%A5%3Cb%3E%E5%8F%98%E6%9B%B4/%E6%B6%88%E7%81%AD%3C/b%3E%E6%97%A2%E5%AD%98%E7%9A%84%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3C/span%3E%3C/td%3E%3C/tr%3E%3C/tbody%3E%3C/table%3E%3C/div%3E" _note="" _mubu_note=""/>
            <outline text="举例：请求确认婚姻关系无效（消极确认之诉）vs 请求离婚（形成之诉）" _mubu_text="%3Cspan%3E%E4%B8%BE%E4%BE%8B%EF%BC%9A%E8%AF%B7%E6%B1%82%E7%A1%AE%E8%AE%A4%E5%A9%9A%E5%A7%BB%E5%85%B3%E7%B3%BB%E6%97%A0%E6%95%88%EF%BC%88%E6%B6%88%E6%9E%81%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%EF%BC%89vs%20%E8%AF%B7%E6%B1%82%E7%A6%BB%E5%A9%9A%EF%BC%88%E5%BD%A2%E6%88%90%E4%B9%8B%E8%AF%89%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="5. 民法中的形成权 ≠ 民事诉讼中的形成之诉" _mubu_text="%3Cspan%3E5.%20%E6%B0%91%E6%B3%95%E4%B8%AD%E7%9A%84%E5%BD%A2%E6%88%90%E6%9D%83%20%E2%89%A0%20%E6%B0%91%E4%BA%8B%E8%AF%89%E8%AE%BC%E4%B8%AD%E7%9A%84%E5%BD%A2%E6%88%90%E4%B9%8B%E8%AF%89%3C/span%3E" _note="" _mubu_note="">
            <outline text="普通形成权：可通过单方通知行使" _mubu_text="%3Cspan%3E%E6%99%AE%E9%80%9A%E5%BD%A2%E6%88%90%E6%9D%83%EF%BC%9A%E5%8F%AF%E9%80%9A%E8%BF%87%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%8D%95%E6%96%B9%E9%80%9A%E7%9F%A5%3C/span%3E%3Cspan%3E%E8%A1%8C%E4%BD%BF%3C/span%3E" _note="如合同解除权" _mubu_note="%3Cspan%3E%E5%A6%82%E5%90%88%E5%90%8C%E8%A7%A3%E9%99%A4%E6%9D%83%3C/span%3E">
              <outline text="基于普通形成权提起的诉讼：确认之诉" _mubu_text="%3Cspan%3E%E5%9F%BA%E4%BA%8E%E6%99%AE%E9%80%9A%E5%BD%A2%E6%88%90%E6%9D%83%E6%8F%90%E8%B5%B7%E7%9A%84%E8%AF%89%E8%AE%BC%EF%BC%9A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E7%A1%AE%E8%AE%A4%E4%B9%8B%E8%AF%89%3C/span%3E" _note="" _mubu_note=""/>
              <outline text="比如起诉解除合同，合同自通知到达对方时解除，判决仅确认解除效力，无形成力" _mubu_text="%3Cspan%3E%E6%AF%94%E5%A6%82%3C/span%3E%3Cspan%20class=%22bold%22%3E%E8%B5%B7%E8%AF%89%E8%A7%A3%E9%99%A4%3C/span%3E%3Cspan%3E%E5%90%88%E5%90%8C%EF%BC%8C%E5%90%88%E5%90%8C%E8%87%AA%3C/span%3E%3Cspan%20class=%22underline%22%3E%E9%80%9A%E7%9F%A5%E5%88%B0%E8%BE%BE%3C/span%3E%3Cspan%3E%E5%AF%B9%E6%96%B9%E6%97%B6%E8%A7%A3%E9%99%A4%EF%BC%8C%E5%88%A4%E5%86%B3%3C/span%3E%3Cspan%20class=%22underline%22%3E%E4%BB%85%E7%A1%AE%E8%AE%A4%E8%A7%A3%E9%99%A4%E6%95%88%E5%8A%9B%3C/span%3E%3Cspan%3E%EF%BC%8C%E6%97%A0%E5%BD%A2%E6%88%90%E5%8A%9B%3C/span%3E" _note="" _mubu_note=""/>
              <outline text="民法典依据：第565条，合同自起诉状副本送达对方时解除，而非判决生效时" _mubu_text="%3Cspan%3E%E6%B0%91%E6%B3%95%E5%85%B8%E4%BE%9D%E6%8D%AE%EF%BC%9A%E7%AC%AC565%E6%9D%A1%EF%BC%8C%E5%90%88%E5%90%8C%E8%87%AA%3C/span%3E%3Cspan%20class=%22bold%20underline%22%3E%E8%B5%B7%E8%AF%89%E7%8A%B6%E5%89%AF%E6%9C%AC%E9%80%81%E8%BE%BE%3C/span%3E%3Cspan%3E%E5%AF%B9%E6%96%B9%E6%97%B6%3C/span%3E%3Cspan%20class=%22bold%22%3E%E8%A7%A3%E9%99%A4%3C/span%3E%3Cspan%3E%EF%BC%8C%E8%80%8C%E9%9D%9E%E5%88%A4%E5%86%B3%E7%94%9F%E6%95%88%E6%97%B6%3C/span%3E" _note="" _mubu_note=""/>
            </outline>
            <outline text="形成诉权：必须通过诉讼 / 仲裁行使" _mubu_text="%3Cspan%20class=%22bold%22%3E%E5%BD%A2%E6%88%90%E8%AF%89%E6%9D%83%3C/span%3E%3Cspan%3E%EF%BC%9A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%BF%85%E9%A1%BB%3C/span%3E%3Cspan%3E%E9%80%9A%E8%BF%87%3C/span%3E%3Cspan%20class=%22bold%22%3E%E8%AF%89%E8%AE%BC%20/%20%E4%BB%B2%E8%A3%81%3C/span%3E%3Cspan%3E%E8%A1%8C%E4%BD%BF%3C/span%3E" _note="如合同撤销权、债权人撤销权" _mubu_note="%3Cspan%3E%E5%A6%82%E5%90%88%E5%90%8C%E6%92%A4%E9%94%80%E6%9D%83%E3%80%81%E5%80%BA%E6%9D%83%E4%BA%BA%E6%92%A4%E9%94%80%E6%9D%83%3C/span%3E">
              <outline text="基于形成诉权提起的诉讼：形成之诉" _mubu_text="%3Cspan%3E%E5%9F%BA%E4%BA%8E%E5%BD%A2%E6%88%90%E8%AF%89%E6%9D%83%E6%8F%90%E8%B5%B7%E7%9A%84%E8%AF%89%E8%AE%BC%EF%BC%9A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%BD%A2%E6%88%90%E4%B9%8B%E8%AF%89%3C/span%3E" _note="" _mubu_note=""/>
              <outline text="比如起诉撤销合同、债权人撤销权诉讼，必须通过生效判决才能变更/消灭法律关系，判决具有形成力" _mubu_text="%3Cspan%3E%E6%AF%94%E5%A6%82%3C/span%3E%3Cspan%20class=%22bold%22%3E%E8%B5%B7%E8%AF%89%E6%92%A4%E9%94%80%3C/span%3E%3Cspan%3E%E5%90%88%E5%90%8C%E3%80%81%E5%80%BA%E6%9D%83%E4%BA%BA%E6%92%A4%E9%94%80%E6%9D%83%E8%AF%89%E8%AE%BC%EF%BC%8C%E5%BF%85%E9%A1%BB%E9%80%9A%E8%BF%87%E7%94%9F%E6%95%88%E5%88%A4%E5%86%B3%E6%89%8D%E8%83%BD%E5%8F%98%E6%9B%B4/%E6%B6%88%E7%81%AD%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%EF%BC%8C%E5%88%A4%E5%86%B3%E5%85%B7%E6%9C%89%E5%BD%A2%E6%88%90%E5%8A%9B%3C/span%3E" _note="" _mubu_note=""/>
              <outline text="民法典依据：第147-151条（可撤销民事法律行为）、第538-539条（债权人撤销权）" _mubu_text="%3Cspan%3E%E6%B0%91%E6%B3%95%E5%85%B8%E4%BE%9D%E6%8D%AE%EF%BC%9A%E7%AC%AC147-151%E6%9D%A1%EF%BC%88%E5%8F%AF%E6%92%A4%E9%94%80%E6%B0%91%E4%BA%8B%E6%B3%95%E5%BE%8B%E8%A1%8C%E4%B8%BA%EF%BC%89%E3%80%81%E7%AC%AC538-539%E6%9D%A1%EF%BC%88%E5%80%BA%E6%9D%83%E4%BA%BA%E6%92%A4%E9%94%80%E6%9D%83%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            </outline>
          </outline>
        </outline>
      </outline>
      <outline text="三、反诉" _mubu_text="%3Cspan%3E%E4%B8%89%E3%80%81%E5%8F%8D%E8%AF%89%3C/span%3E" _note="" _mubu_note="">
        <outline text="定义：在本诉进行中，本诉的被告向本诉的原告提出的独立的反请求" _mubu_text="%3Cspan%3E%E5%AE%9A%E4%B9%89%EF%BC%9A%E5%9C%A8%E6%9C%AC%E8%AF%89%E8%BF%9B%E8%A1%8C%E4%B8%AD%EF%BC%8C%E6%9C%AC%E8%AF%89%E7%9A%84%E8%A2%AB%E5%91%8A%E5%90%91%E6%9C%AC%E8%AF%89%E7%9A%84%E5%8E%9F%E5%91%8A%E6%8F%90%E5%87%BA%E7%9A%84%3C/span%3E%3Cspan%20class=%22bold%22%3E%E7%8B%AC%E7%AB%8B%E7%9A%84%E5%8F%8D%E8%AF%B7%E6%B1%82%3C/span%3E" _note="" _mubu_note=""/>
        <outline text="反诉的构成要件（5个）" _mubu_text="%3Cspan%3E%E5%8F%8D%E8%AF%89%E7%9A%84%E6%9E%84%E6%88%90%E8%A6%81%E4%BB%B6%EF%BC%885%E4%B8%AA%EF%BC%89%3C/span%3E" _note="" _mubu_note="">
          <outline text="1. 主体同一性：反诉只能由本诉被告向本诉原告提出" _mubu_text="%3Cspan%3E1.%20%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%B8%BB%E4%BD%93%E5%90%8C%E4%B8%80%E6%80%A7%3C/span%3E%3Cspan%3E%EF%BC%9A%E5%8F%8D%E8%AF%89%E5%8F%AA%E8%83%BD%E7%94%B1%E6%9C%AC%E8%AF%89%E8%A2%AB%E5%91%8A%E5%90%91%E6%9C%AC%E8%AF%89%E5%8E%9F%E5%91%8A%E6%8F%90%E5%87%BA%3C/span%3E" _note="主体相同但诉讼地位相反（本诉原告→反诉被告，本诉被告→反诉原告）" _mubu_note="%3Cspan%3E%E4%B8%BB%E4%BD%93%E7%9B%B8%E5%90%8C%E4%BD%86%E8%AF%89%E8%AE%BC%E5%9C%B0%E4%BD%8D%E7%9B%B8%E5%8F%8D%EF%BC%88%E6%9C%AC%E8%AF%89%E5%8E%9F%E5%91%8A%E2%86%92%E5%8F%8D%E8%AF%89%E8%A2%AB%E5%91%8A%EF%BC%8C%E6%9C%AC%E8%AF%89%E8%A2%AB%E5%91%8A%E2%86%92%E5%8F%8D%E8%AF%89%E5%8E%9F%E5%91%8A%EF%BC%89%3C/span%3E"/>
          <outline text="2. 牵连关系：本反诉之间存在牵连关系" _mubu_text="%3Cspan%3E2.%20%3C/span%3E%3Cspan%20class=%22bold%22%3E%E7%89%B5%E8%BF%9E%E5%85%B3%E7%B3%BB%3C/span%3E%3Cspan%3E%EF%BC%9A%E6%9C%AC%E5%8F%8D%E8%AF%89%E4%B9%8B%E9%97%B4%E5%AD%98%E5%9C%A8%E7%89%B5%E8%BF%9E%E5%85%B3%E7%B3%BB%3C/span%3E" _note="" _mubu_note="">
            <outline text="易错点：牵连关系不要求基于相同法律关系" _mubu_text="%3Cspan%3E%E6%98%93%E9%94%99%E7%82%B9%EF%BC%9A%E7%89%B5%E8%BF%9E%E5%85%B3%E7%B3%BB%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%B8%8D%E8%A6%81%E6%B1%82%E5%9F%BA%E4%BA%8E%E7%9B%B8%E5%90%8C%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="【案例】张三起诉李四要求支付房屋租金（租赁合同关系），李四反诉张三要求赔偿因房屋天花板脱落造成的医疗费8000元（侵权法律关系），二者存在牵连，构成反诉" _mubu_text="%3Cspan%3E%E3%80%90%E6%A1%88%E4%BE%8B%E3%80%91%E5%BC%A0%E4%B8%89%E8%B5%B7%E8%AF%89%E6%9D%8E%E5%9B%9B%E8%A6%81%E6%B1%82%E6%94%AF%E4%BB%98%E6%88%BF%E5%B1%8B%E7%A7%9F%E9%87%91%EF%BC%88%E7%A7%9F%E8%B5%81%E5%90%88%E5%90%8C%E5%85%B3%E7%B3%BB%EF%BC%89%EF%BC%8C%E6%9D%8E%E5%9B%9B%E5%8F%8D%E8%AF%89%E5%BC%A0%E4%B8%89%E8%A6%81%E6%B1%82%E8%B5%94%E5%81%BF%E5%9B%A0%E6%88%BF%E5%B1%8B%E5%A4%A9%E8%8A%B1%E6%9D%BF%E8%84%B1%E8%90%BD%E9%80%A0%E6%88%90%E7%9A%84%E5%8C%BB%E7%96%97%E8%B4%B98000%E5%85%83%EF%BC%88%E4%BE%B5%E6%9D%83%E6%B3%95%E5%BE%8B%E5%85%B3%E7%B3%BB%EF%BC%89%EF%BC%8C%E4%BA%8C%E8%80%85%E5%AD%98%E5%9C%A8%E7%89%B5%E8%BF%9E%EF%BC%8C%E6%9E%84%E6%88%90%E5%8F%8D%E8%AF%89%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="3. 时间要求：反诉必须在一审法庭辩论终结前提出" _mubu_text="%3Cspan%3E3.%20%3C/span%3E%3Cspan%20class=%22bold%22%3E%E6%97%B6%E9%97%B4%E8%A6%81%E6%B1%82%3C/span%3E%3Cspan%3E%EF%BC%9A%E5%8F%8D%E8%AF%89%E5%BF%85%E9%A1%BB%E5%9C%A8%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%B8%80%E5%AE%A1%E6%B3%95%E5%BA%AD%E8%BE%A9%E8%AE%BA%E7%BB%88%E7%BB%93%E5%89%8D%3C/span%3E%3Cspan%3E%E6%8F%90%E5%87%BA%3C/span%3E" _note="" _mubu_note="">
            <outline text="二审中反诉的：二审法院只能调解，不能直接判决" _mubu_text="%3Cspan%3E%E4%BA%8C%E5%AE%A1%E4%B8%AD%E5%8F%8D%E8%AF%89%E7%9A%84%EF%BC%9A%E4%BA%8C%E5%AE%A1%E6%B3%95%E9%99%A2%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%8F%AA%E8%83%BD%E8%B0%83%E8%A7%A3%3C/span%3E%3Cspan%3E%EF%BC%8C%E4%B8%8D%E8%83%BD%E7%9B%B4%E6%8E%A5%E5%88%A4%E5%86%B3%3C/span%3E" _note="否则剥夺反诉当事人的上诉权，违反两审终审" _mubu_note="%3Cspan%3E%E5%90%A6%E5%88%99%E5%89%A5%E5%A4%BA%E5%8F%8D%E8%AF%89%E5%BD%93%E4%BA%8B%E4%BA%BA%E7%9A%84%E4%B8%8A%E8%AF%89%E6%9D%83%EF%BC%8C%E8%BF%9D%E5%8F%8D%E4%B8%A4%E5%AE%A1%E7%BB%88%E5%AE%A1%3C/span%3E"/>
            <outline text="→ 调解不成的，告知当事人另行起诉" _mubu_text="%3Cspan%3E%E2%86%92%20%E8%B0%83%E8%A7%A3%E4%B8%8D%E6%88%90%E7%9A%84%EF%BC%8C%E5%91%8A%E7%9F%A5%E5%BD%93%E4%BA%8B%E4%BA%BA%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%8F%A6%E8%A1%8C%E8%B5%B7%E8%AF%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="例外：当事人同意由二审法院一并审理并作出判决的，二审法院可以一并审理" _mubu_text="%3Cspan%20class=%22bold%22%3E%E4%BE%8B%E5%A4%96%EF%BC%9A%E5%BD%93%E4%BA%8B%E4%BA%BA%E5%90%8C%E6%84%8F%3C/span%3E%3Cspan%3E%E7%94%B1%E4%BA%8C%E5%AE%A1%E6%B3%95%E9%99%A2%E4%B8%80%E5%B9%B6%E5%AE%A1%E7%90%86%E5%B9%B6%E4%BD%9C%E5%87%BA%E5%88%A4%E5%86%B3%E7%9A%84%EF%BC%8C%E4%BA%8C%E5%AE%A1%E6%B3%95%E9%99%A2%E5%8F%AF%E4%BB%A5%E4%B8%80%E5%B9%B6%E5%AE%A1%E7%90%86%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="4. 管辖要求：反诉向受理本诉的法院提出即可" _mubu_text="%3Cspan%3E4.%20%3C/span%3E%3Cspan%20class=%22bold%22%3E%E7%AE%A1%E8%BE%96%E8%A6%81%E6%B1%82%3C/span%3E%3Cspan%3E%EF%BC%9A%E5%8F%8D%E8%AF%89%E5%90%91%3C/span%3E%3Cspan%20class=%22underline%22%3E%E5%8F%97%E7%90%86%E6%9C%AC%E8%AF%89%E7%9A%84%E6%B3%95%E9%99%A2%3C/span%3E%3Cspan%3E%E6%8F%90%E5%87%BA%E5%8D%B3%E5%8F%AF%3C/span%3E" _note="" _mubu_note="">
            <outline text="受理本诉的法院基于牵连关系取得对反诉的管辖权（牵连管辖）" _mubu_text="%3Cspan%3E%E5%8F%97%E7%90%86%E6%9C%AC%E8%AF%89%E7%9A%84%E6%B3%95%E9%99%A2%E5%9F%BA%E4%BA%8E%3C/span%3E%3Cspan%20class=%22underline%22%3E%E7%89%B5%E8%BF%9E%E5%85%B3%E7%B3%BB%3C/span%3E%3Cspan%3E%E5%8F%96%E5%BE%97%E5%AF%B9%E5%8F%8D%E8%AF%89%E7%9A%84%E7%AE%A1%E8%BE%96%E6%9D%83%EF%BC%88%E7%89%B5%E8%BF%9E%E7%AE%A1%E8%BE%96%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
            <outline text=" 例外：反诉专属于其他法院管辖的除外（专属管辖除外）" _mubu_text="%3Cspan%3E%20%E4%BE%8B%E5%A4%96%EF%BC%9A%E5%8F%8D%E8%AF%89%3C/span%3E%3Cspan%20class=%22bold%22%3E%E4%B8%93%E5%B1%9E%E4%BA%8E%3C/span%3E%3Cspan%3E%E5%85%B6%E4%BB%96%E6%B3%95%E9%99%A2%E7%AE%A1%E8%BE%96%E7%9A%84%E9%99%A4%E5%A4%96%EF%BC%88%E4%B8%93%E5%B1%9E%E7%AE%A1%E8%BE%96%E9%99%A4%E5%A4%96%EF%BC%89%3C/span%3E" _note="" _mubu_note=""/>
          </outline>
          <outline text="5. 程序要求：本反诉应当适用同一诉讼程序审理" _mubu_text="%3Cspan%3E5.%20%3C/span%3E%3Cspan%20class=%22bold%22%3E%E7%A8%8B%E5%BA%8F%E8%A6%81%E6%B1%82%3C/span%3E%3Cspan%3E%EF%BC%9A%E6%9C%AC%E5%8F%8D%E8%AF%89%E5%BA%94%E5%BD%93%E9%80%82%E7%94%A8%3C/span%3E%3Cspan%20class=%22underline%22%3E%E5%90%8C%E4%B8%80%E8%AF%89%E8%AE%BC%E7%A8%8B%E5%BA%8F%3C/span%3E%3Cspan%3E%E5%AE%A1%E7%90%86%3C/span%3E" _note="" _mubu_note=""/>
        </outline>
        <outline text="反诉的核心理论：反诉是一个独立的诉" _mubu_text="%3Cspan%3E%E5%8F%8D%E8%AF%89%E7%9A%84%E6%A0%B8%E5%BF%83%E7%90%86%E8%AE%BA%EF%BC%9A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%8F%8D%E8%AF%89%E6%98%AF%E4%B8%80%E4%B8%AA%E7%8B%AC%E7%AB%8B%E7%9A%84%E8%AF%89%3C/span%3E" _note="考试唯一理论考点" _mubu_note="%3Cspan%3E%E8%80%83%E8%AF%95%E5%94%AF%E4%B8%80%E7%90%86%E8%AE%BA%E8%80%83%E7%82%B9%3C/span%3E">
          <outline text="1. 反诉 vs 反驳的区分 #必考" _mubu_text="%3Cspan%3E1.%20%E5%8F%8D%E8%AF%89%20vs%20%E5%8F%8D%E9%A9%B3%E7%9A%84%E5%8C%BA%E5%88%86%20%3C/span%3E%3Cspan%20class=%22tag%22%3E#%E5%BF%85%E8%80%83%3C/span%3E" _note="" _mubu_note="">
            <outline text="#秒杀技巧" _mubu_text="%3Cspan%20class=%22tag%22%3E#%E7%A7%92%E6%9D%80%E6%8A%80%E5%B7%A7%3C/span%3E" _note="" _mubu_note="">
              <outline text="第一步：找到被告的主张是什么" _mubu_text="%3Cspan%3E%E7%AC%AC%E4%B8%80%E6%AD%A5%EF%BC%9A%E6%89%BE%E5%88%B0%E8%A2%AB%E5%91%8A%E7%9A%84%E4%B8%BB%E5%BC%A0%E6%98%AF%E4%BB%80%E4%B9%88%3C/span%3E" _note="" _mubu_note=""/>
              <outline text="第二步：假设去掉原告的起诉，看被告能否就自己的主张单独直接向法院起诉" _mubu_text="%3Cspan%3E%E7%AC%AC%E4%BA%8C%E6%AD%A5%EF%BC%9A%E5%81%87%E8%AE%BE%E5%8E%BB%E6%8E%89%E5%8E%9F%E5%91%8A%E7%9A%84%E8%B5%B7%E8%AF%89%EF%BC%8C%E7%9C%8B%E8%A2%AB%E5%91%8A%E8%83%BD%E5%90%A6%E5%B0%B1%E8%87%AA%E5%B7%B1%E7%9A%84%E4%B8%BB%E5%BC%A0%3C/span%3E%3Cspan%20class=%22bold%20underline%22%3E%E5%8D%95%E7%8B%AC%E7%9B%B4%E6%8E%A5%3C/span%3E%3Cspan%20class=%22bold%22%3E%E5%90%91%E6%B3%95%E9%99%A2%E8%B5%B7%E8%AF%89%3C/span%3E" _note="" _mubu_note=""/>
              <outline text="第三步：能起诉→独立的诉→反诉；不能起诉→反驳" _mubu_text="%3Cspan%3E%E7%AC%AC%E4%B8%89%E6%AD%A5%EF%BC%9A%E8%83%BD%E8%B5%B7%E8%AF%89%E2%86%92%E7%8B%AC%E7%AB%8B%E7%9A%84%E8%AF%89%E2%86%92%E5%8F%8D%E8%AF%89%EF%BC%9B%E4%B8%8D%E8%83%BD%E8%B5%B7%E8%AF%89%E2%86%92%E5%8F%8D%E9%A9%B3%3C/span%3E" _note="" _mubu_note=""/>
            </outline>
            <outline text="绝对误区：绝对不能用“抵消、折抵”等法律效果区分，反诉和反驳都可能产生抵消效果" _mubu_text="%3Cspan%3E%E7%BB%9D%E5%AF%B9%E8%AF%AF%E5%8C%BA%EF%BC%9A%3C/span%3E%3Cspan%20class=%22bold%22%3E%E7%BB%9D%E5%AF%B9%E4%B8%8D%E8%83%BD%E7%94%A8%E2%80%9C%E6%8A%B5%E6%B6%88%E3%80%81%E6%8A%98%E6%8A%B5%E2%80%9D%E7%AD%89%E6%B3%95%E5%BE%8B%E6%95%88%E6%9E%9C%E5%8C%BA%E5%88%86%3C/span%3E%3Cspan%3E%EF%BC%8C%E5%8F%8D%E8%AF%89%E5%92%8C%E5%8F%8D%E9%A9%B3%E9%83%BD%E5%8F%AF%E8%83%BD%E4%BA%A7%E7%94%9F%E6%8A%B5%E6%B6%88%E6%95%88%E6%9E%9C%3C/span%3E" _note="" _mubu_note=""/>
            <outline text="【案例解析】" _mubu_text="%3Cspan%3E%E3%80%90%E6%A1%88%E4%BE%8B%E8%A7%A3%E6%9E%90%E3%80%91%3C/span%3E" _note="" _mubu_note="">
              <outline text="| 例题 | 被告主张 | 能否单独起诉 | 性质 |
| --- | --- | --- | --- |
| 原告起诉被告归还借款10万，被告称借款已归还 | 借款已归还 | 不能（没人会起诉确认自己已还钱） | 反驳 |
| 原告起诉被告归还借款10万，被告称借款已过诉讼时效 | 借款已过诉讼时效 | 不能 | 反驳 |
| 原告起诉被告履行合同，被告称合同无效，要求原告承担缔约过失责任 | 确认合同无效+要求原告承担缔约过失责任 | 能 | 反诉 |
| 原告起诉被告归还借款10万，被告称一个月前卖给原告一块玉石，要求用玉石货款折抵借款 | 要求原告支付玉石货款 | 能（玉石买卖合同关系独立存在） | 反诉 |" _mubu_text="%3Cdiv%20class=%22table-container%22%3E%3Ctable%20class=%22auto-table%22%20border=%221%22%20cellspacing=%220%22%20style=%22border-collapse:%20collapse;%22%3E%3Cthead%3E%3Ctr%3E%3Cth%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22column-select-btn%22%20data-col=%220%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E5%88%97%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cdiv%20class=%22row-select-btn%22%20data-row=%220%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E8%A1%8C%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E4%BE%8B%E9%A2%98%3C/span%3E%3C/th%3E%3Cth%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22column-select-btn%22%20data-col=%221%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E5%88%97%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E8%A2%AB%E5%91%8A%E4%B8%BB%E5%BC%A0%3C/span%3E%3C/th%3E%3Cth%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22column-select-btn%22%20data-col=%222%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E5%88%97%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E8%83%BD%E5%90%A6%E5%8D%95%E7%8B%AC%E8%B5%B7%E8%AF%89%3C/span%3E%3C/th%3E%3Cth%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22column-select-btn%22%20data-col=%223%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E5%88%97%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contenteditable=%22true%22%3E%E6%80%A7%E8%B4%A8%3C/span%3E%3C/th%3E%3C/tr%3E%3C/thead%3E%3Ctbody%3E%3Ctr%3E%3Ctd%20tabindex=%220%22%20contenteditable=%22false%22%3E%3Cdiv%20class=%22row-select-btn%22%20data-row=%221%22%20title=%22%E9%80%89%E6%8B%A9%E6%AD%A4%E8%A1%8C%22%20contenteditable=%22false%22%3E%3C/div%3E%3Cspan%20class=%22edit-area%22%20contentedita